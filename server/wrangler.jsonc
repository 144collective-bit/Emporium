// The Degen City game server: one Worker, four kinds of Durable Object.
// (Plot sales for PLS were retired: the Land object is gone and plots are game property.)
// It also serves the built website (the site's only home).
// Cloudflare deploys it from GitHub on every push to main (Workers Builds); see README.md here.
{
  "name": "emporium",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Free play (src/scripts/city3d/freeplay.ts), in step with the site's build (FREE_FOR_NOW in astro.config.mjs):
  // the owner's test phase, every gun and rifle finish unlocked. "false" (or removing this) ends it here.
  "define": { "__FREE_PLAY__": "true" },
  // The website, built by `wrangler deploy` itself (see "build") into ../dist and served from here.
  // The game's own paths always reach the Worker code; anything else is a page or a file of the site.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/play", "/health", "/auth/*"]
  },
  "build": {
    // Installs the website's packages first if the build machine hasn't (Cloudflare's build may only install server/'s),
    // then builds the site, makes its textures in a headless Chromium (scripts/bake-textures.mjs: Playwright's own,
    // fetched if it isn't there) and holds the start to its budgets (scripts/budget.mjs: on CI a build without the
    // textures is red), as the "Build site" Action does
    "command": "cd .. && (test -d node_modules/astro || npm ci) && PUBLIC_GAME_SERVER=https://emporium.144collective.workers.dev PUBLIC_BUILD=$(git rev-parse --short HEAD 2>/dev/null || echo dev) npm run build && (npx playwright-core install chromium || true) && npm run bake:textures && npm run budget"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "PROFILES", "class_name": "Profile" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "Room", "Profile"] },
    { "tag": "v2", "new_sqlite_classes": ["Land"] },
    { "tag": "v3", "new_sqlite_classes": ["Accounts"] },
    { "tag": "v4", "deleted_classes": ["Land"] }
  ],
  "vars": {
    // Pages allowed to connect (other sites can't embed the game)
    "ALLOWED_ORIGINS": "https://emporium.144collective.workers.dev,http://localhost:4321",
    // The network wallets log in on. 943 = PulseChain Testnet v4, 369 = PulseChain mainnet.
    "AUTH_CHAIN_ID": "943"
  },
  "observability": { "enabled": true }
}
