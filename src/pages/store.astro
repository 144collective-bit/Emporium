---
import Base from '../layouts/Base.astro';

const categories = ['ALL ARTIFACTS', 'APPAREL', 'STICKERS', 'HARDWARE // COLLECTIBLES'];

const storeProducts = [
  {
    id: 'tee-01',
    title: 'Genesis Heavyweight Streetwear Tee',
    category: 'APPAREL',
    priceEth: '0.045 ETH',
    priceDemp: '1,250 DEMP',
    status: 'IN STOCK',
    image: '/images/tshirt-cutout.png',
    bgTint: 'rgba(0, 245, 255, 0.08)',
    desc: 'Heavyweight 280 GSM combed cotton featuring the hand-drawn Degen Emporium backprint and custom woven hem label.',
  },
  {
    id: 'stickers-01',
    title: 'Genesis Holographic Sticker Pack',
    category: 'STICKERS',
    priceEth: '0.020 ETH',
    priceDemp: '550 DEMP',
    status: 'IN STOCK',
    image: '/images/store-home.png',
    bgTint: 'rgba(216, 180, 254, 0.08)',
    desc: 'Full 14-piece vinyl sticker sheet with weatherproof UV coating and prismatic chrome edges for dark hardware surfaces.',
  },
  {
    id: 'hoodie-01',
    title: 'Cyber Obsidian Crew Hoodie',
    category: 'APPAREL',
    priceEth: '0.085 ETH',
    priceDemp: '2,400 DEMP',
    status: 'LIMITED RUN (50/100)',
    image: '/images/store-page.png',
    bgTint: 'rgba(0, 245, 255, 0.05)',
    desc: '450 GSM ultra-dense fleece hoodie with high-density embroidered chest graffiti and an embedded encrypted NFC chip.',
  },
  {
    id: 'artifact-01',
    title: 'Solid Metallic Balaclava Figurine',
    category: 'HARDWARE // COLLECTIBLES',
    priceEth: '0.150 ETH',
    priceDemp: '4,200 DEMP',
    status: 'PRE-ORDER',
    image: '/brand/pfp/gold-mask-pfp.png',
    bgTint: 'rgba(251, 146, 60, 0.08)',
    desc: 'Solid cast zinc-alloy collector sculpture finished in electroplated gold with custom acrylic museum case.',
  },
  {
    id: 'print-01',
    title: 'Comic Issue #01 Prismatic Foil Print',
    category: 'HARDWARE // COLLECTIBLES',
    priceEth: '0.035 ETH',
    priceDemp: '980 DEMP',
    status: 'SPECIAL EDITION',
    image: '/images/news-character-cutout.png',
    bgTint: 'rgba(0, 255, 136, 0.08)',
    desc: 'Archival quality 18x24" screenprint on 300 GSM Black Rainbow Foil paper, hand-numbered and stamped by the studio.',
  },
  {
    id: 'mask-01',
    title: 'Tactical Ribbed Degen Balaclava',
    category: 'APPAREL',
    priceEth: '0.030 ETH',
    priceDemp: '850 DEMP',
    status: 'IN STOCK',
    image: '/images/tshirt-cutout.png',
    bgTint: 'rgba(244, 63, 94, 0.08)',
    desc: 'Breathable tactical knit balaclava with reflective ink typographic branding and moisture-wicking weave.',
  }
];
---

<Base title="Store | The Degen Emporium" description="Official physical streetwear, stickers, and artifacts from The Degen Emporium.">
  {/* Page Header Banner */}
  <header class="page-window-header" style="background: linear-gradient(180deg, rgba(14, 18, 28, 0.9) 0%, rgba(6, 7, 10, 0.95) 100%); border-bottom: 1px solid var(--border); padding: 48px 24px 40px;">
    <div class="wrap" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
      <div style="max-width: 640px;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
          <a href="/" style="display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 11px; color: var(--cyan); text-decoration: none; background: rgba(0, 245, 255, 0.1); border: 1px solid rgba(0, 245, 255, 0.25); padding: 3px 10px; border-radius: 9999px;">
            &larr; COMIC HQ
          </a>
          <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">/</span>
          <span class="comic-pill" style="border-color: var(--cyan); color: var(--cyan);">
            WINDOW 01 &bull; STORE
          </span>
        </div>

        <h1 style="font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); font-weight: 900; line-height: 1.1; margin-bottom: 14px; letter-spacing: -0.02em;">
          OFFICIAL <span class="title-gradient">STOREFRONT</span>
        </h1>

        <p style="font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin: 0;">
          Physical streetwear, holographic sticker packs, and limited-edition artifacts built exclusively for holders and decentralized operatives.
        </p>
      </div>

      {/* Quick Store Stats Box */}
      <div style="background: rgba(18, 24, 38, 0.8); border: 1px solid var(--border); border-radius: 16px; padding: 20px 24px; display: flex; gap: 28px; backdrop-filter: blur(12px);">
        <div>
          <div style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); margin-bottom: 4px;">GLOBAL SHIPPING</div>
          <div style="font-family: var(--font-display); font-size: 18px; font-weight: 800; color: #fff;">WORLDWIDE</div>
          <div style="font-family: var(--font-mono); font-size: 10px; color: var(--green);">TRACKED &bull; AR/BASE/ETH</div>
        </div>
        <div style="width: 1px; background: var(--border-subtle);"></div>
        <div>
          <div style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); margin-bottom: 4px;">DISCOUNT FOR $DEMP</div>
          <div style="font-family: var(--font-display); font-size: 18px; font-weight: 800; color: var(--cyan);">-20% AUTO</div>
          <div style="font-family: var(--font-mono); font-size: 10px; color: var(--text-secondary);">WHEN PAYING WITH $DEMP</div>
        </div>
      </div>
    </div>
  </header>

  {/* Store Catalog Section */}
  <main class="wrap" style="padding: 40px 24px 90px;">
    {/* Categories Toolbar */}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-tab ${idx === 0 ? 'is-active' : ''}`}
            style={`padding: 8px 16px; border-radius: 9999px; font-family: var(--font-display); font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; border: 1px solid ${idx === 0 ? 'var(--cyan)' : 'var(--border)'}; background: ${idx === 0 ? 'rgba(0, 245, 255, 0.12)' : 'rgba(255, 255, 255, 0.03)'}; color: ${idx === 0 ? 'var(--cyan)' : 'var(--text-secondary)'};`}
          >
            {cat}
          </button>
        ))}
      </div>

      <div style="font-family: var(--font-mono); font-size: 12.5px; color: var(--text-muted);">
        SHOWING <strong>6 ARTIFACTS</strong>
      </div>
    </div>

    {/* Products Grid */}
    <div class="store-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 28px;">
      {storeProducts.map((item) => (
        <article class="product-card" style="background: rgba(14, 18, 28, 0.75); border: 1px solid var(--border); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;">
          {/* Card Media Preview */}
          <div style={`height: 240px; background: ${item.bgTint}; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--border-subtle);`}>
            <div style="position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 0); background-size: 14px 14px; opacity: 0.6;"></div>
            
            <img
              src={item.image}
              alt={item.title}
              style="max-height: 82%; max-width: 82%; object-fit: contain; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.6)); transition: transform 0.3s ease;"
              loading="lazy"
            />

            <span style="position: absolute; top: 14px; right: 14px; background: rgba(6, 7, 10, 0.85); border: 1px solid rgba(0, 245, 255, 0.4); color: var(--cyan); font-family: var(--font-mono); font-size: 10px; font-weight: 700; padding: 4px 10px; border-radius: 9999px; backdrop-filter: blur(8px);">
              {item.status}
            </span>
          </div>

          {/* Card Details */}
          <div style="padding: 24px; display: flex; flex-direction: column; flex: 1; justify-content: space-between;">
            <div>
              <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); letter-spacing: 0.05em; margin-bottom: 6px;">
                {item.category}
              </div>
              
              <h3 style="font-family: var(--font-display); font-size: 19px; font-weight: 700; color: #fff; margin-bottom: 8px; line-height: 1.3;">
                {item.title}
              </h3>
              
              <p style="font-size: 13.5px; color: var(--text-secondary); line-height: 1.55; margin-bottom: 20px;">
                {item.desc}
              </p>
            </div>

            <div style="border-top: 1px solid rgba(255,255,255,0.06); padding-top: 18px; display: flex; justify-content: space-between; align-items: flex-end;">
              <div>
                <div style="font-family: var(--font-mono); font-size: 17px; font-weight: 800; color: #fff;">
                  {item.priceEth}
                </div>
                <div style="font-family: var(--font-mono); font-size: 11px; color: var(--cyan);">
                  or {item.priceDemp}
                </div>
              </div>

              <button
                type="button"
                class="btn btn-cyan btn-sm store-add-btn"
                data-item-title={item.title}
                style="padding: 9px 18px; font-size: 12.5px;"
              >
                Add to Cart
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Base>

<script>
  const addButtons = document.querySelectorAll('.store-add-btn');
  addButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const originalText = target.textContent;
      target.textContent = 'Added! ✓';
      target.style.background = '#00ff88';
      target.style.color = '#000';
      setTimeout(() => {
        target.textContent = originalText;
        target.style.background = '';
        target.style.color = '';
      }, 1600);
    });
  });
</script>
