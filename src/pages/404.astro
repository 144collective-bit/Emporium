---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="notfound wrap">
    <p class="kicker"><span class="kicker-num">404</span> Page not found</p>
    <h1 class="notfound-title">This page got rugged.</h1>
    <p class="notfound-text">Whatever was here isn't anymore. Happens to the best of us.</p>
    <a href="/" class="btn-acid">Back to the Emporium <span aria-hidden="true">→</span></a>
  </section>
</Base>
