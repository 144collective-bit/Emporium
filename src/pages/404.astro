---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found">
  <div class="hero-wrapper wrap" style="padding: 100px 0;">
    <div class="hero-content">
      <div class="hero-pill">
        <span>ERROR 404 &bull; VECTOR NULL</span>
      </div>
      <h1 class="hero-title" style="font-size:clamp(40px, 6vw, 72px);">
        PAGE NOT <span class="title-gradient">FOUND</span>
      </h1>
      <p class="hero-description">
        The requested endpoint does not exist. Return to the main emporium terminal.
      </p>
      <a href="/" class="btn btn-cyan">
        Return to Home &rarr;
      </a>
    </div>
  </div>
</Base>
