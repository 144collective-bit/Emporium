---
import Base from '../layouts/Base.astro';

const alphaFeeds = [
  {
    id: 'signal-01',
    source: 'ARBITRUM // L2 RADAR',
    title: 'High-Frequency Arbitrage Flow & Yield Aggregation',
    time: '2m ago',
    signal: 'STRONG BUY // APY 34.8%',
    category: 'YIELD AGGREGATION',
    confidence: '98.4%',
    desc: 'Automated treasury rebalancing into liquidity vaults across Uniswap v3 & Camelot pools. Gas efficiency sustained at 0.08 Gwei with zero slippage execution.',
    metrics: { tvl: '$12.4M', apy: '34.8%', risk: 'LOW // AUDITED' },
  },
  {
    id: 'signal-02',
    source: 'BASE // ON-CHAIN SENTRY',
    title: 'Smart Contract Burn Event Indexed',
    time: '14m ago',
    signal: 'DEFLATIONARY TRIGGER',
    category: 'BURN EVENT',
    confidence: '100%',
    desc: '120,000 $DEMP auto-routed from secondary protocol marketplace fees directly into the 0x000...dead incineration address. Circulating supply reduced by 0.14%.',
    metrics: { burned: '120,000 DEMP', tx: '0x3f1...8a9', fee: '1.5%' },
  },
  {
    id: 'signal-03',
    source: 'MAINNET // WHALE RADAR',
    title: 'Genesis Vault Accumulation Detected',
    time: '42m ago',
    signal: 'LARGE HOLDER INFLOW',
    category: 'WHALE TRACKER',
    confidence: '94.2%',
    desc: 'Wallet 0x4a8...99e acquired 18 Genesis artifact pieces from open market floor. Total staked proportion in community staking contract now exceeds 78.4%.',
    metrics: { pieces: '18 ARTIFACTS', totalHeld: '142', stakeStatus: 'LOCKED' },
  },
  {
    id: 'signal-04',
    source: 'CROSS-CHAIN // FLASH MONITOR',
    title: 'Uniswap v3 Concentrated Liquidity Rebalance',
    time: '1h 10m ago',
    signal: 'RANGE OPTIMIZATION',
    category: 'DEX TELEMETRY',
    confidence: '96.8%',
    desc: 'Automated liquidity position adjusted between $0.038 and $0.048 to capture peak trading volume while maximizing fee returns for active liquidity providers.',
    metrics: { pool: 'DEMP/ETH', spread: '0.05%', volume24h: '$4.2M' },
  }
];
---

<Base title="On-Chain Alpha | The Degen Emporium" description="Real-time on-chain telemetry, staking yields, and intelligence from The Degen Emporium.">
  {/* Page Header Banner */}
  <header class="page-window-header" style="background: linear-gradient(180deg, rgba(8, 24, 18, 0.95) 0%, rgba(6, 7, 10, 0.98) 100%); border-bottom: 1px solid rgba(0, 255, 136, 0.3); padding: 48px 24px 40px;">
    <div class="wrap" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
      <div style="max-width: 640px;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
          <a href="/" style="display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 11px; color: var(--green); text-decoration: none; background: rgba(0, 255, 136, 0.1); border: 1px solid rgba(0, 255, 136, 0.3); padding: 3px 10px; border-radius: 9999px;">
            &larr; COMIC HQ
          </a>
          <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">/</span>
          <span class="comic-pill" style="border-color: var(--green); color: var(--green);">
            WINDOW 03 &bull; ON-CHAIN ALPHA
          </span>
        </div>

        <h1 style="font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); font-weight: 900; line-height: 1.1; margin-bottom: 14px; letter-spacing: -0.02em;">
          INTELLIGENCE <span style="color: var(--green);">RADAR</span>
        </h1>

        <p style="font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin: 0;">
          Real-time decentralized telemetry, automated whale alerts, and yield-maximizing signals directly indexing L2 and Mainnet contracts.
        </p>
      </div>

      {/* Radar Status Live Indicator */}
      <div style="background: rgba(12, 28, 20, 0.85); border: 1px solid rgba(0, 255, 136, 0.3); border-radius: 18px; padding: 20px 26px; display: flex; align-items: center; gap: 20px; backdrop-filter: blur(12px);">
        <div style="position: relative; width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--green); display: flex; align-items: center; justify-content: center;">
          <div style="position: absolute; inset: 6px; border-radius: 50%; border: 1px dashed rgba(0, 255, 136, 0.5);"></div>
          <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 12px var(--green);"></div>
        </div>
        <div>
          <div style="font-family: var(--font-mono); font-size: 10px; color: var(--green); margin-bottom: 3px;">SIGNAL MONITOR</div>
          <div style="font-family: var(--font-display); font-size: 17px; font-weight: 800; color: #fff;">LIVE TELEMETRY</div>
          <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary);">BLOCK TIME: 0.25s &bull; ARB ONE</div>
        </div>
      </div>
    </div>
  </header>

  {/* Main Alpha Feeds */}
  <main class="wrap" style="padding: 40px 24px 90px; max-width: 1000px;">
    {/* Alpha Stats Strip */}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-bottom: 36px;">
      <div style="background: rgba(14, 18, 28, 0.7); border: 1px solid var(--border); border-radius: 16px; padding: 20px 24px;">
        <div style="font-family: var(--font-mono); font-size: 10.5px; color: var(--text-muted); margin-bottom: 4px;">CURRENT STAKING APY</div>
        <div style="font-family: var(--font-display); font-size: 26px; font-weight: 900; color: var(--green);">34.8%</div>
        <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary);">Dynamic automated compounding</div>
      </div>

      <div style="background: rgba(14, 18, 28, 0.7); border: 1px solid var(--border); border-radius: 16px; padding: 20px 24px;">
        <div style="font-family: var(--font-mono); font-size: 10.5px; color: var(--text-muted); margin-bottom: 4px;">TOTAL VALUE INDEXED</div>
        <div style="font-family: var(--font-display); font-size: 26px; font-weight: 900; color: #fff;">$24.8M</div>
        <div style="font-family: var(--font-mono); font-size: 11px; color: var(--cyan);">Across Arbitrum & Base</div>
      </div>

      <div style="background: rgba(14, 18, 28, 0.7); border: 1px solid var(--border); border-radius: 16px; padding: 20px 24px;">
        <div style="font-family: var(--font-mono); font-size: 10.5px; color: var(--text-muted); margin-bottom: 4px;">24H BURN RATE</div>
        <div style="font-family: var(--font-display); font-size: 26px; font-weight: 900; color: #fb923c;">184,200 DEMP</div>
        <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary);">Perpetual supply shrinkage</div>
      </div>
    </div>

    {/* Signals List */}
    <div style="display: flex; flex-direction: column; gap: 24px;">
      {alphaFeeds.map((feed) => (
        <article style="background: rgba(14, 18, 28, 0.75); border: 1px solid rgba(0, 255, 136, 0.2); border-radius: 20px; padding: 28px 32px; transition: all 0.25s ease; backdrop-filter: blur(14px);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="font-family: var(--font-mono); font-size: 11px; color: var(--cyan); background: rgba(0, 245, 255, 0.08); border: 1px solid rgba(0, 245, 255, 0.25); padding: 4px 10px; border-radius: 6px;">
                {feed.source}
              </span>
              <span style="font-family: var(--font-mono); font-size: 12px; color: var(--text-muted);">
                {feed.time}
              </span>
            </div>

            <span style="font-family: var(--font-mono); font-size: 11px; font-weight: 700; color: var(--green); background: rgba(0, 255, 136, 0.1); border: 1px solid rgba(0, 255, 136, 0.3); padding: 4px 12px; border-radius: 9999px;">
              {feed.signal}
            </span>
          </div>

          <h2 style="font-family: var(--font-display); font-size: 21px; font-weight: 800; color: #fff; margin-bottom: 10px;">
            {feed.title}
          </h2>

          <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.65; margin-bottom: 20px;">
            {feed.desc}
          </p>

          {/* Quick Metrics Bar */}
          <div style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 14px 20px; display: flex; gap: 24px; flex-wrap: wrap;">
            {Object.entries(feed.metrics).map(([k, v]) => (
              <div>
                <span style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); text-transform: uppercase;">{k}: </span>
                <strong style="font-family: var(--font-mono); font-size: 12px; color: #fff;">{v}</strong>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </main>
</Base>
