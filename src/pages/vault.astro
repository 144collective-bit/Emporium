---
import Base from '../layouts/Base.astro';

const vaultMetrics = [
  { label: 'GENESIS COLLECTION', val: '5,555 PIECES', highlight: true, note: 'ERC-721A Provenance' },
  { label: 'TOTAL INCINERATED', val: '14,200,000 $DEMP', highlight: true, note: '14.2% of Total Supply' },
  { label: 'AUDIT SECURITY SCORE', val: '100% SECURE', highlight: false, note: 'CertiK & OpenZeppelin' },
  { label: 'MULTI-SIG OPERATORS', val: '4 OF 7 SIGNERS', highlight: false, note: 'Hardware Timelock 48h' },
];

const burnEvents = [
  { tx: '0x8b4...12f', amount: '250,000 DEMP', reason: 'Secondary Store Fee Buyback', time: '18m ago', gas: '0.04 Gwei' },
  { tx: '0x3a9...90c', amount: '120,000 DEMP', reason: 'Marketplace Volume Routing', time: '1h 05m ago', gas: '0.08 Gwei' },
  { tx: '0x7e2...54b', amount: '450,000 DEMP', reason: 'Vault Staking Protocol Dividend', time: '3h 22m ago', gas: '0.05 Gwei' },
  { tx: '0x1c8...39a', amount: '1,000,000 DEMP', reason: 'Genesis Artifact Redemption Burn', time: '12h ago', gas: '0.12 Gwei' },
];
---

<Base title="Deflationary Vault | The Degen Emporium" description="Deflationary burn mechanics, genesis artifact vaults, and audit provenance.">
  {/* Page Header Banner */}
  <header class="page-window-header" style="background: linear-gradient(180deg, rgba(32, 18, 10, 0.95) 0%, rgba(6, 7, 10, 0.98) 100%); border-bottom: 1px solid rgba(251, 146, 60, 0.3); padding: 48px 24px 40px;">
    <div class="wrap" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
      <div style="max-width: 640px;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
          <a href="/" style="display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 11px; color: #fb923c; text-decoration: none; background: rgba(251, 146, 60, 0.1); border: 1px solid rgba(251, 146, 60, 0.3); padding: 3px 10px; border-radius: 9999px;">
            &larr; COMIC HQ
          </a>
          <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">/</span>
          <span class="comic-pill" style="border-color: #fb923c; color: #fb923c;">
            WINDOW 05 &bull; DEFLATIONARY VAULT
          </span>
        </div>

        <h1 style="font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); font-weight: 900; line-height: 1.1; margin-bottom: 14px; letter-spacing: -0.02em;">
          AUTONOMOUS <span style="color: #fb923c;">BURN ENGINE</span>
        </h1>

        <p style="font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin: 0;">
          The cryptographic core of The Degen Emporium: perpetual fee buybacks, provable token incineration, and immutable timelocked artifacts.
        </p>
      </div>

      {/* Burn Engine Fire Indicator */}
      <div style="background: rgba(36, 20, 12, 0.85); border: 1px solid rgba(251, 146, 60, 0.35); border-radius: 18px; padding: 20px 28px; backdrop-filter: blur(12px);">
        <div style="font-family: var(--font-mono); font-size: 10.5px; color: #fb923c; margin-bottom: 4px;">INCINERATION COUNTER</div>
        <div style="font-family: var(--font-display); font-size: 28px; font-weight: 900; color: #fff; line-height: 1;">
          14,200,000 <span style="font-size: 16px; color: #fb923c;">DEMP</span>
        </div>
        <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); margin-top: 6px;">
          PROVABLY ROUTED TO 0x0...DEAD
        </div>
      </div>
    </div>
  </header>

  {/* Main Vault Content */}
  <main class="wrap" style="padding: 40px 24px 90px; max-width: 1040px;">
    {/* Vault Stats Grid */}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-bottom: 42px;">
      {vaultMetrics.map((m) => (
        <div style="background: rgba(14, 18, 28, 0.75); border: 1px solid rgba(251, 146, 60, 0.25); border-radius: 16px; padding: 22px;">
          <div style="font-family: var(--font-mono); font-size: 10.5px; color: var(--text-muted); margin-bottom: 6px;">
            {m.label}
          </div>
          <div style={`font-family: var(--font-display); font-size: 24px; font-weight: 800; color: ${m.highlight ? '#fb923c' : '#fff'};`}>
            {m.val}
          </div>
          <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); margin-top: 5px;">
            {m.note}
          </div>
        </div>
      ))}
    </div>

    {/* Provenance & Security Architecture */}
    <section style="background: rgba(14, 18, 28, 0.7); border: 1px solid var(--border); border-radius: 20px; padding: 32px; margin-bottom: 40px;">
      <h2 style="font-family: var(--font-display); font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 14px;">
        On-Chain Provenance & Verification
      </h2>
      <p style="font-size: 14.5px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 20px;">
        Every swap routed through our decentralized automated market makers incurs a programmatic 1.5% fee. 100% of these collected tokens are immediately transferred to the official zero-address burn destination. Once committed, the tokens are irreversibly removed from circulating existence, provably compressing total available supply.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <div style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 20px;">
          <div style="font-family: var(--font-mono); font-size: 11px; color: var(--cyan); margin-bottom: 6px;">AUDITED BY CERTIK</div>
          <div style="font-size: 13.5px; color: #fff; font-weight: 600;">Zero High / Critical Vulnerabilities</div>
          <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Formal verification on ERC-721A minting and burn routing contracts.</div>
        </div>

        <div style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 20px;">
          <div style="font-family: var(--font-mono); font-size: 11px; color: var(--green); margin-bottom: 6px;">TIMELOCK CONTROLLER</div>
          <div style="font-size: 13.5px; color: #fff; font-weight: 600;">48-Hour Delay on Admin Functions</div>
          <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Community multi-sig ensures no sudden upgrades or parameter modifications.</div>
        </div>
      </div>
    </section>

    {/* Recent Burn Events Ledger */}
    <section style="background: rgba(14, 18, 28, 0.7); border: 1px solid var(--border); border-radius: 20px; padding: 32px;">
      <h2 style="font-family: var(--font-display); font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 20px;">
        Recent Autonomous Burn Transactions
      </h2>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 13px;">
          <thead>
            <tr style="border-bottom: 1px solid var(--border); color: var(--text-muted); text-align: left; font-size: 11px;">
              <th style="padding: 12px 16px;">TX HASH</th>
              <th style="padding: 12px 16px;">AMOUNT BURNED</th>
              <th style="padding: 12px 16px;">TRIGGER SOURCE</th>
              <th style="padding: 12px 16px;">TIME</th>
              <th style="padding: 12px 16px;">GAS</th>
            </tr>
          </thead>
          <tbody>
            {burnEvents.map((e) => (
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 16px; color: var(--cyan);">{e.tx}</td>
                <td style="padding: 16px; color: #fb923c; font-weight: 700;">{e.amount}</td>
                <td style="padding: 16px; color: #fff;">{e.reason}</td>
                <td style="padding: 16px; color: var(--text-muted);">{e.time}</td>
                <td style="padding: 16px; color: var(--green);">{e.gas}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Base>
