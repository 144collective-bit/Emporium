---
import Base from '../layouts/Base.astro';

const terminalEndpoints = [
  { name: 'ARBITRUM ONE RPC', status: 'ONLINE', latency: '12ms', gas: '0.08 GWEI', block: '248,192,401' },
  { name: 'BASE L2 RPC', status: 'ONLINE', latency: '15ms', gas: '0.04 GWEI', block: '18,442,109' },
  { name: 'ETHEREUM MAINNET', status: 'ONLINE', latency: '24ms', gas: '18 GWEI', block: '20,891,332' },
  { name: 'DEGEN INDEXER SUBNET', status: 'SYNCED', latency: '6ms', gas: 'N/A', block: 'REALTIME' },
];

const quickCommands = [
  { cmd: 'status', desc: 'Display global protocol health and node synchronicity' },
  { cmd: 'price', desc: 'Fetch latest aggregated $DEMP spot price across DEXs' },
  { cmd: 'burn --stats', desc: 'Inspect cumulative token incineration analytics' },
  { cmd: 'route --l2', desc: 'Simulate cross-rollup arbitrage execution' },
];
---

<Base title="Degen Terminal | The Degen Emporium" description="Protocol telemetry, RPC node switcher, and smart contract terminal.">
  {/* Page Header Banner */}
  <header class="page-window-header" style="background: linear-gradient(180deg, rgba(10, 20, 28, 0.95) 0%, rgba(6, 7, 10, 0.98) 100%); border-bottom: 1px solid var(--border); padding: 48px 24px 40px;">
    <div class="wrap" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
      <div style="max-width: 640px;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
          <a href="/" style="display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 11px; color: var(--cyan); text-decoration: none; background: rgba(0, 245, 255, 0.1); border: 1px solid rgba(0, 245, 255, 0.25); padding: 3px 10px; border-radius: 9999px;">
            &larr; COMIC HQ
          </a>
          <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">/</span>
          <span class="comic-pill" style="border-color: var(--cyan); color: var(--cyan);">
            WINDOW 06 &bull; PROTOCOL TERMINAL
          </span>
        </div>

        <h1 style="font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); font-weight: 900; line-height: 1.1; margin-bottom: 14px; letter-spacing: -0.02em;">
          DEGEN <span class="title-gradient">TERMINAL v3.0</span>
        </h1>

        <p style="font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin: 0;">
          Direct protocol telemetry, RPC node health monitor, and command-line execution interface for decentralized operators.
        </p>
      </div>

      {/* Terminal Node Live Pill */}
      <div style="background: rgba(14, 24, 34, 0.85); border: 1px solid var(--border); border-radius: 18px; padding: 20px 28px; backdrop-filter: blur(12px);">
        <div style="font-family: var(--font-mono); font-size: 10.5px; color: var(--cyan); margin-bottom: 4px;">OPERATING MODE</div>
        <div style="font-family: var(--font-display); font-size: 22px; font-weight: 900; color: #fff;">DIRECT RPC GATEWAY</div>
        <div style="font-family: var(--font-mono); font-size: 11px; color: var(--green); margin-top: 4px;">
          &bull; 4/4 SUBNETS ONLINE (0.00% PACKET LOSS)
        </div>
      </div>
    </div>
  </header>

  {/* Main Terminal Body */}
  <main class="wrap" style="padding: 40px 24px 90px; max-width: 1040px;">
    {/* Interactive Console Window */}
    <section style="background: rgba(10, 12, 18, 0.95); border: 1px solid var(--border); border-radius: 18px; overflow: hidden; margin-bottom: 40px; box-shadow: 0 20px 40px rgba(0,0,0,0.6);">
      {/* Console Top Bar */}
      <div style="background: rgba(18, 22, 32, 0.9); border-bottom: 1px solid var(--border-subtle); padding: 12px 20px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="width: 11px; height: 11px; border-radius: 50%; background: #f43f5e; display: inline-block;"></span>
          <span style="width: 11px; height: 11px; border-radius: 50%; background: #fb923c; display: inline-block;"></span>
          <span style="width: 11px; height: 11px; border-radius: 50%; background: var(--green); display: inline-block;"></span>
          <span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--text-secondary); margin-left: 10px;">
            root@degen-emporium:~ (v3.0.4-mainnet)
          </span>
        </div>
        <span style="font-family: var(--font-mono); font-size: 11px; color: var(--cyan);">ENCRYPTED TLS 1.3</span>
      </div>

      {/* Interactive Console Screen */}
      <div id="terminal-screen" style="padding: 24px; font-family: var(--font-mono); font-size: 13.5px; line-height: 1.7; min-height: 220px; color: var(--text);">
        <p style="color: var(--text-muted); margin: 0 0 10px 0;">[SYSTEM READY] The Degen Emporium Protocol Gateway initialized.</p>
        <p style="color: var(--cyan); margin: 0 0 10px 0;">&gt; Type <span style="color: #fff; text-decoration: underline;">help</span>, <span style="color: #fff; text-decoration: underline;">status</span>, <span style="color: #fff; text-decoration: underline;">price</span>, or <span style="color: #fff; text-decoration: underline;">burn</span> to interact with the protocol terminal.</p>
        
        <div id="terminal-output" style="margin-bottom: 12px;"></div>

        {/* Input Line */}
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="color: var(--green); font-weight: 700;">degen@emp:~$</span>
          <input
            type="text"
            id="terminal-input"
            placeholder="enter command (e.g. status)..."
            style="background: transparent; border: none; outline: none; color: #fff; font-family: var(--font-mono); font-size: 13.5px; flex: 1;"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>
    </section>

    {/* Live RPC Endpoints Table */}
    <section style="background: rgba(14, 18, 28, 0.7); border: 1px solid var(--border); border-radius: 20px; padding: 32px; margin-bottom: 40px;">
      <h2 style="font-family: var(--font-display); font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 20px;">
        RPC Node Health & Telemetry
      </h2>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 13px;">
          <thead>
            <tr style="border-bottom: 1px solid var(--border); color: var(--text-muted); text-align: left; font-size: 11px;">
              <th style="padding: 12px 16px;">NETWORK / RPC</th>
              <th style="padding: 12px 16px;">STATUS</th>
              <th style="padding: 12px 16px;">LATENCY</th>
              <th style="padding: 12px 16px;">GAS PRICE</th>
              <th style="padding: 12px 16px;">BLOCK HEIGHT</th>
            </tr>
          </thead>
          <tbody>
            {terminalEndpoints.map((ep) => (
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 16px; color: #fff; font-weight: 600;">{ep.name}</td>
                <td style="padding: 16px; color: var(--green); font-weight: 700;">{ep.status}</td>
                <td style="padding: 16px; color: var(--cyan);">{ep.latency}</td>
                <td style="padding: 16px; color: var(--text-secondary);">{ep.gas}</td>
                <td style="padding: 16px; color: var(--text-muted);">{ep.block}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* Quick Gateway Commands */}
    <section style="background: rgba(14, 18, 28, 0.7); border: 1px solid var(--border); border-radius: 20px; padding: 32px;">
      <h2 style="font-family: var(--font-display); font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 16px;">
        Direct Window Gateways
      </h2>
      <p style="font-size: 14px; color: var(--text-secondary); margin-bottom: 20px;">
        Quick links to browse other comic window pages directly:
      </p>

      <div style="display: flex; gap: 14px; flex-wrap: wrap;">
        <a href="/" class="btn btn-cyan btn-sm">← Comic HQ Home</a>
        <a href="/store" class="btn btn-glass btn-sm">Window 01: Store ↗</a>
        <a href="/blog" class="btn btn-glass btn-sm">Window 02: News ↗</a>
        <a href="/alpha" class="btn btn-glass btn-sm">Window 03: Alpha ↗</a>
        <a href="/tokenomics" class="btn btn-glass btn-sm">Window 04: Tokenomics ↗</a>
        <a href="/vault" class="btn btn-glass btn-sm">Window 05: Vault ↗</a>
      </div>
    </section>
  </main>
</Base>

<script>
  const input = document.getElementById('terminal-input') as HTMLInputElement;
  const output = document.getElementById('terminal-output');

  if (input && output) {
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = input.value.trim().toLowerCase();
        if (!val) return;

        let res = '';
        if (val === 'help') {
          res = 'Available commands: status, price, burn, help, clear, hq, store, news, alpha, tokenomics, vault';
        } else if (val === 'status') {
          res = 'OK: All 4 RPC gateways operational. Arbitrum (12ms), Base (15ms), Mainnet (24ms).';
        } else if (val === 'price') {
          res = '$DEMP spot price: $0.0428 (+14.2% 24h). 24h Volume: $18.4M across Uniswap v3 & Aerodrome.';
        } else if (val === 'burn') {
          res = 'Deflationary Burn Engine: 14,200,000 $DEMP incinerated. Fee routing: 1.5% auto-diverted per swap.';
        } else if (val === 'hq') {
          window.location.href = '/';
          return;
        } else if (val === 'store') {
          window.location.href = '/store';
          return;
        } else if (val === 'clear') {
          output.innerHTML = '';
          input.value = '';
          return;
        } else {
          res = `Command not recognized: '${val}'. Type 'help' for available commands.`;
        }

        const line = document.createElement('div');
        line.style.marginBottom = '8px';
        line.innerHTML = `<span style="color: var(--green);">degen@emp:~$</span> <span style="color: #fff;">${val}</span><br><span style="color: var(--text-secondary);">${res}</span>`;
        output.appendChild(line);
        input.value = '';
      }
    });
  }
</script>
