---
import { SITE_NAME, X_URL, TELEGRAM_URL, DISCORD_URL } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navTabs = [
  { label: 'Comic HQ', href: '/', badge: 'HQ', desc: 'Hero Grid Spread', color: 'var(--cyan)' },
  { label: 'Store', href: '/store', badge: '01', desc: 'Streetwear & Stickers', color: 'var(--cyan)' },
  { label: 'News', href: '/blog', badge: '02', desc: 'Dispatches & Lore', color: '#d8b4fe' },
  { label: 'Alpha', href: '/alpha', badge: '03', desc: 'On-Chain Signals & APY', color: 'var(--green)' },
  { label: 'Tokenomics', href: '/tokenomics', badge: '04', desc: '$DEMP Supply & DEX Pools', color: 'var(--cyan)' },
  { label: 'Vault', href: '/vault', badge: '05', desc: 'Autonomous Burn Engine', color: '#fb923c' },
  { label: 'Terminal', href: '/terminal', badge: '06', desc: 'Degen RPC Gateway v3', color: 'var(--green)' },
];
---

<nav class="nav" id="site-nav">
  <div class="nav-in">
    {/* Left: Clean Brand Identity */}
    <div class="nav-brand-group">
      <a href="/" class="brand" aria-label="The Degen Emporium Home">
        <span class="brand-logo-gem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </span>
        <span class="brand-text">DEGEN EMPORIUM</span>
        <span class="brand-badge">
          <span class="pulse-dot"></span>
          <span>MAINNET</span>
        </span>
      </a>
    </div>

    {/* Center: Full Segmented Tabs Bar (Desktop > 1120px) */}
    <div class="nav-tabs-wrapper">
      <div class="nav-tabs-bar">
        {navTabs.map((tab) => {
          const isActive = tab.href === '/' ? currentPath === '/' : currentPath.startsWith(tab.href);
          return (
            <a
              href={tab.href}
              class={`nav-tab-item ${isActive ? 'is-active' : ''}`}
            >
              <span class="nav-tab-badge">{tab.badge}</span>
              <span class="nav-tab-label">{tab.label}</span>
              {isActive && (
                <span class="nav-tab-beacon">
                  <span class="nav-tab-active-dot" />
                  <span class="nav-tab-ping" />
                </span>
              )}
            </a>
          );
        })}
      </div>
    </div>

    {/* Right: Actions (Wallet + Socials + Mobile Dropdown Trigger) */}
    <div class="nav-actions">
      {/* Social Links (Desktop > 1120px) */}
      <div class="nav-social-group">
        <a href={X_URL} target="_blank" rel="noopener noreferrer" class="social-link-icon" aria-label="X / Twitter" title="X (Twitter)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>

        <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" class="social-link-icon" aria-label="Telegram" title="Telegram">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
        </a>
      </div>

      {/* Animated Glowing Connect Wallet Button (Always Visible across views) */}
      <div class="nav-glow-btn-wrapper">
        <div class="btn-glow-aura"></div>
        <button type="button" class="btn btn-animated-glow nav-wallet-btn" id="connect-wallet-btn" aria-label="Connect Web3 Wallet">
          <span class="wallet-status-dot"></span>
          <span class="wallet-btn-label">Connect</span>
        </button>
      </div>

      {/* Professional Dropdown Trigger (Tablet & Mobile <= 1120px) */}
      <button
        type="button"
        class="nav-dropdown-trigger"
        id="nav-dropdown-trigger"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="nav-dropdown-panel"
      >
        <span class="dropdown-trigger-icon">
          <span class="line line-1"></span>
          <span class="line line-2"></span>
          <span class="line line-3"></span>
        </span>
        <span class="dropdown-trigger-text">Menu</span>
        <span class="dropdown-trigger-chevron">▾</span>
      </button>
    </div>

    {/* Anchored Professional Floating Dropdown Menu */}
    <div class="nav-dropdown-panel" id="nav-dropdown-panel" aria-hidden="true">
      <div class="dropdown-panel-header">
        <div class="dropdown-header-status">
          <span class="pulse-dot"></span>
          <span>MAINNET ONLINE &bull; V3.0</span>
        </div>
        <button type="button" class="dropdown-panel-close-btn" id="nav-dropdown-close" aria-label="Close Menu">
          ✕
        </button>
      </div>

      <div class="dropdown-items-list">
        {navTabs.map((tab) => {
          const isActive = tab.href === '/' ? currentPath === '/' : currentPath.startsWith(tab.href);
          return (
            <a
              href={tab.href}
              class={`dropdown-nav-row ${isActive ? 'is-active' : ''}`}
            >
              <div class="dropdown-row-left">
                <span class="dropdown-row-badge" style={`color: ${tab.color}; border-color: ${tab.color}44;`}>
                  {tab.badge}
                </span>
                <div class="dropdown-row-text">
                  <span class="dropdown-row-title">{tab.label}</span>
                  <span class="dropdown-row-desc">{tab.desc}</span>
                </div>
              </div>

              {isActive ? (
                <span class="dropdown-row-active-tag">ACTIVE</span>
              ) : (
                <span class="dropdown-row-arrow">&rarr;</span>
              )}
            </a>
          );
        })}
      </div>

      <div class="dropdown-panel-footer">
        <div class="dropdown-footer-socials">
          <a href={X_URL} target="_blank" rel="noopener noreferrer" class="dropdown-social-item">
            <span>𝕏 Twitter</span>
          </a>
          <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" class="dropdown-social-item">
            <span>Telegram Channel</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  {/* Backdrop click dismisser */}
  <div class="nav-dropdown-backdrop" id="nav-dropdown-backdrop"></div>

  {/* Subtle Cyber Neon Underline */}
  <div class="nav-cyber-line"></div>
</nav>

<script>
  // Connect Wallet Toggle Logic
  const walletBtn = document.getElementById('connect-wallet-btn') as HTMLButtonElement;
  let isConnected = false;

  if (walletBtn) {
    walletBtn.addEventListener('click', () => {
      isConnected = !isConnected;
      const label = walletBtn.querySelector('.wallet-btn-label');
      const dot = walletBtn.querySelector('.wallet-status-dot') as HTMLElement;
      if (isConnected) {
        if (label) label.textContent = '0x71C8...';
        walletBtn.classList.add('is-connected');
        if (dot) {
          dot.style.background = '#00ff88';
          dot.style.boxShadow = '0 0 8px #00ff88';
        }
      } else {
        if (label) label.textContent = 'Connect';
        walletBtn.classList.remove('is-connected');
        if (dot) {
          dot.style.background = '#00f5ff';
          dot.style.boxShadow = '0 0 8px #00f5ff';
        }
      }
    });
  }

  // Professional Dropdown Toggle Logic
  const trigger = document.getElementById('nav-dropdown-trigger');
  const panel = document.getElementById('nav-dropdown-panel');
  const backdrop = document.getElementById('nav-dropdown-backdrop');
  const closeBtn = document.getElementById('nav-dropdown-close');

  function openDropdown() {
    if (!panel || !trigger) return;
    panel.classList.add('is-open');
    trigger.classList.add('is-open');
    trigger.setAttribute('aria-expanded', 'true');
    panel.setAttribute('aria-hidden', 'false');
    if (backdrop) backdrop.classList.add('is-open');
  }

  function closeDropdown() {
    if (!panel || !trigger) return;
    panel.classList.remove('is-open');
    trigger.classList.remove('is-open');
    trigger.setAttribute('aria-expanded', 'false');
    panel.setAttribute('aria-hidden', 'true');
    if (backdrop) backdrop.classList.remove('is-open');
  }

  if (trigger) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (panel?.classList.contains('is-open')) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });
  }

  if (backdrop) backdrop.addEventListener('click', closeDropdown);
  if (closeBtn) closeBtn.addEventListener('click', closeDropdown);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('is-open')) {
      closeDropdown();
    }
  });
</script>
