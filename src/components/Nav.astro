---
import { Image, Picture } from 'astro:assets';
import logo from '../assets/logo.png';
import pulsechain from '../assets/pulsechain.png';
import { X_URL, X_HANDLE, TELEGRAM_URL } from '../data/site';
---

<header class="nav">
  <div class="nav-in">
    <a href="/" class="logo" aria-label="The Degen Emporium, home">
      <Picture
        src={logo}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[100, 150, 200, 300]}
        sizes="(max-width: 640px) 74px, 100px"
        alt=""
        loading="eager"
        class="logo-img"
      />
    </a>

    <div class="nav-right">
      <span class="chain-badge">
        <Image src={pulsechain} alt="" width={18} densities={[1, 2, 3]} class="chain-badge-mark" />
        <span class="chain-badge-text">PulseChain native</span>
      </span>

      <nav class="nav-social" aria-label="Social">
        <a href={X_URL} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label={`@${X_HANDLE} on X`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="Telegram">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
        </a>
      </nav>
    </div>
  </div>
</header>
