      <button type="button" class="city-card-close" data-guide-close aria-label="Hide the getting started guide">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
      </button>
    </div>

    {/* Stands in for the card's draft note when the card is hidden (always on phones); with the build's commit, to tell which version is live */}
    <p class="city-draft-tag">Draft · v0{build && ` · ${build}`}</p>
  </div>
  {/* Keep a closed welcome card closed on return, before first paint so it doesn't flash */}
  <script is:inline>
    try {
      if (localStorage.getItem('city-card') === 'hidden') {
        document.querySelector('[data-city-hud]').dataset.card = 'hidden';
      }
    } catch {}
  </script>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-city-root]');
  const vp = document.querySelector<HTMLElement>('[data-city]');
  const svg = vp?.querySelector('svg');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && vp && svg) {
    // Open on the Emporium
    vp.scrollLeft = svg.clientWidth * Number(vp.dataset.focusX) - vp.clientWidth / 2;
    vp.scrollTop = svg.clientHeight * Number(vp.dataset.focusY) - vp.clientHeight / 2;

    // Drag to pan with a mouse; touch and trackpads scroll natively
    let drag: { x: number; y: number; left: number; top: number } | null = null;
    let moved = false;
    vp.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, y: e.clientY, left: vp.scrollLeft, top: vp.scrollTop };
      moved = false;
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!moved && Math.hypot(dx, dy) > 5) {
        moved = true;
        vp.classList.add('is-dragging');
      }
      if (moved) {
        vp.scrollLeft = drag.left - dx;
        vp.scrollTop = drag.top - dy;
      }
    });
    window.addEventListener('pointerup', () => {
      drag = null;
      vp.classList.remove('is-dragging');
    });
    // A drag that ends on a building is not a click
    vp.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true
    );
    vp.addEventListener('dragstart', (e) => e.preventDefault());

    // A building and its pin light up together
    const hot = (id: string, on: boolean) =>
      vp.querySelectorAll(`[data-spot="${id}"]`).forEach((el) => el.classList.toggle('is-hot', on));
    vp.querySelectorAll<SVGElement>('[data-spot]').forEach((el) => {
      const id = el.dataset.spot!;
      el.addEventListener('pointerenter', () => hot(id, true));
      el.addEventListener('pointerleave', () => hot(id, false));
      el.addEventListener('focus', () => hot(id, true));
      el.addEventListener('blur', () => hot(id, false));
    });

    // Tablets and desktops: the welcome card can be closed, and stays closed on return
    document.querySelector('[data-card-close]')?.addEventListener('click', () => {
      const hud = document.querySelector<HTMLElement>('[data-city-hud]')!;
      hud.dataset.card = 'hidden';
      try {
        localStorage.setItem('city-card', 'hidden');
      } catch {}
      vp.focus({ preventScroll: true });
    });

    // Drop-open menus (City settings, Directory, walk mode's panels) close with their ×, a tap
    // outside or Esc (in 3D, index.ts handles Esc so it can come before leaving a mode)
    const openMenus = () => root.querySelectorAll<HTMLDetailsElement>('.head-pop[open], [data-pop][open]');
    // One drop-down at a time (the header's settings and menu, walk mode's panels)
    const pops = root.querySelectorAll<HTMLDetailsElement>('.head-pop, [data-pop]');
    pops.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) pops.forEach((o) => o !== d && (o.open = false));
      })
    );
    root.addEventListener('click', (e) => {
      const menu = (e.target as HTMLElement).closest('[data-pop-close]')?.closest('details');
      if (!menu) return;
      menu.open = false;
      menu.querySelector('summary')?.focus({ preventScroll: true });
    });
    document.addEventListener(
      'pointerdown',
      (e) => {
        for (const menu of openMenus()) if (!menu.contains(e.target as Node)) menu.open = false;
      },
      true,
    );
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || root.dataset.view === '3d') return;
      openMenus().forEach((menu) => (menu.open = false));
    });

    // SMIL animations (cars, rings, the plane) ignore CSS, so pause them here
    if (reduced) svg.pauseAnimations();

    /* ---------- Connect wallet (works on the 2D map too; the 3D city plugs in when it starts) ---------- */
    const server = import.meta.env.PUBLIC_GAME_SERVER as string | undefined;
    const wallet = server
      ? Promise.all([import('../scripts/city3d/account'), import('../scripts/city3d/account-ui')]).then(([{ createAccount }, { createAccountUI }]) => {
          const account = createAccount(server);
          const online = () => {
            try {
              return localStorage.getItem('degen-city-online-v1') !== 'off';
            } catch {
              return true;
            }
          };
          const hooks = {
            online,
            goOnline() {
              try {
                localStorage.setItem('degen-city-online-v1', 'on');
              } catch {}
            },
            rename: () => account.rename(),
            opened() {},
          };
          if (account.address && online()) account.refresh();
          return { account, hooks, ui: createAccountUI(root, account, hooks) };
        })
      : Promise.resolve(null);

    /* ---------- The 3D city ---------- */
    const controls = root.querySelector<HTMLDetailsElement>('[data-controls]')!;
    const to3d = root.querySelector<HTMLButtonElement>('.city-to3d')!;
    let city: { stop(): void; start(): void; open(id: string): void; intro(): void } | null = null;
    let booting = false;
    const remember = (v: string) => {
      try {
        localStorage.setItem('city-view', v);
      } catch {}
    };

    async function go3d() {
      if (booting) return;
      if (city) {
        city.start();
        root!.dataset.view = '3d';
      } else {
        booting = true;
        const { bootCity } = await import('../scripts/city3d/index');
        city = await bootCity(root!, await wallet);
        booting = false;
        if (!city) return show2d(false);
        // Options picked in the start menu before the city was up
        for (const apply of pendingOpts.splice(0)) apply();
      }
      svg!.pauseAnimations();
      to3d.hidden = true;
    }
    function show2d(offer: boolean) {
      city?.stop();
      root!.dataset.view = '2d';
      to3d.hidden = !offer;
      if (!reduced) svg!.unpauseAnimations();
    }
    root.querySelectorAll<HTMLButtonElement>('[data-view-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        remember(b.dataset.viewToggle!);
        if (b.dataset.viewToggle === '3d') go3d();
        else show2d(true);
      })
    );

    // Boot 3D where WebGL2 works, unless the visitor chose the 2D map
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('city-view');
    } catch {}
    const gl = document.createElement('canvas').getContext('webgl2');
    gl?.getExtension('WEBGL_lose_context')?.loseContext();
    // The buildings are places in the 3D city's game: on the 2D map they take you there
    if (gl)
      vp.querySelectorAll<SVGElement>('[data-spot]').forEach((el) =>
        el.addEventListener('click', async (e) => {
          e.preventDefault();
          remember('3d');
          await go3d();
          if (root!.dataset.view === '3d') city?.open(el.dataset.spot!);
        })
      );
    /** Resolves once the first boot has settled (the 3D city is up, or it fell back to the map) */
    let booted: Promise<unknown> = Promise.resolve();
    let bootStarted = false;
    if (!gl) to3d.remove();
    else if (saved === '2d') to3d.hidden = false;
    else {
      bootStarted = true;
      booted = go3d();
    }

    /* ---------- The start menu ---------- */
    const start = root.querySelector<HTMLElement>('[data-start]')!;
    const startMain = start.querySelector<HTMLElement>('[data-start-main]')!;
    const startPane = start.querySelector<HTMLElement>('[data-start-pane]')!;
    const optionsBtn = start.querySelector<HTMLButtonElement>('[data-start-options]')!;
    const status = start.querySelector<HTMLElement>('[data-start-status]')!;
    const startBar = start.querySelector<HTMLElement>('[data-start-bar]')!;
    const loaderBar = root.querySelector<HTMLElement>('[data-loader-bar]')!;
    const loaderEl = root.querySelector<HTMLElement>('[data-loader]')!;
    /** Option choices made before the 3D city was up, applied when it is (its header controls do the work) */
    const pendingOpts: (() => void)[] = [];
    let view = gl ? (saved === '2d' ? '2d' : '3d') : '2d';
    let entering = false;
    let closed = false;

    // The loader's progress, mirrored under the menu
    new MutationObserver(() => startBar.style.setProperty('--p', loaderBar.style.getPropertyValue('--p') || '0')).observe(loaderBar, { attributes: true, attributeFilter: ['style'] });
    new MutationObserver(() => {
      if (loaderEl.classList.contains('is-done')) {
        startBar.style.setProperty('--p', '1');
        if (!entering) status.textContent = 'The city is ready.';
      }
    }).observe(loaderEl, { attributes: true, attributeFilter: ['class'] });
    if (!gl) status.textContent = '3D isn\'t available here: the 2D map it is.';
    else if (saved === '2d') status.textContent = 'The 2D map is picked (Options to change it).';

    function paintOpt(opt: string, val: string) {
      start.querySelectorAll<HTMLButtonElement>(`[data-opt="${opt}"]`).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.val === val)));
    }
    /** An option is the header's own control, pressed now or once the city is up */
    function applyOpt(opt: string, val: string) {
      const run = () => {
        if (opt === 'sound') {
          const b = root!.querySelector<HTMLButtonElement>('[data-controls] [data-sound]');
          if (b && b.getAttribute('aria-pressed') !== String(val === 'on')) b.click();
        } else root!.querySelector<HTMLButtonElement>(`[data-controls] [data-${opt}="${val}"]`)?.click();
      };
      if (city) run();
      else pendingOpts.push(run);
    }
    start.querySelectorAll<HTMLButtonElement>('[data-opt]').forEach((b) =>
      b.addEventListener('click', () => {
        const opt = b.dataset.opt!;
        const val = b.dataset.val!;
        paintOpt(opt, val);
        if (opt === 'view') {
          if (!gl && val === '3d') {
            paintOpt('view', '2d');
            status.textContent = '3D isn\'t available here: the 2D map it is.';
            return;
          }
          view = val;
          remember(val);
          return;
        }
        applyOpt(opt, val);
      })
    );
    if (!gl) paintOpt('view', '2d');
    else if (saved === '2d') paintOpt('view', '2d');
    // The header's sound button is the one that knows (it needs a tap to start): mirror it
    const headSound = root.querySelector<HTMLButtonElement>('[data-controls] [data-sound]');
    if (headSound) new MutationObserver(() => paintOpt('sound', headSound.getAttribute('aria-pressed') === 'true' ? 'on' : 'off')).observe(headSound, { attributes: true, attributeFilter: ['aria-pressed'] });

    function showPane(on: boolean) {
      startPane.hidden = !on;
      startMain.hidden = on;
      optionsBtn.setAttribute('aria-expanded', String(on));
      (on ? startPane.querySelector<HTMLButtonElement>('button') : optionsBtn)?.focus({ preventScroll: true });
    }
    optionsBtn.addEventListener('click', () => showPane(true));
    start.querySelector('[data-start-back]')!.addEventListener('click', () => showPane(false));
    start.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !startPane.hidden) {
        e.stopPropagation();
        showPane(false);
      }
    });

    function closeStart() {
      if (closed) return;
      closed = true;
      root!.classList.remove('has-start');
      start.classList.add('is-done');
      start.setAttribute('aria-hidden', 'true');
      setTimeout(() => (start.hidden = true), 450);
    }
    /** Into the city: the 3D one with its fly-in once it's up, or the 2D map */
    async function enter(multi: boolean) {
      if (entering) return;
      entering = true;
      status.textContent = 'Entering…';
      if (view === '3d') {
        if (!bootStarted) {
          bootStarted = true;
          booted = go3d();
        }
        await booted;
      } else {
        await booted;
        show2d(gl !== null);
      }
      if (multi && server && city) root!.querySelector<HTMLButtonElement>('[data-online-set="on"]')?.click();
      closeStart();
      if (root!.dataset.view === '3d' && city) city.intro();
      else vp!.focus({ preventScroll: true });
      entering = false;
    }
    start.querySelector('[data-start-single]')!.addEventListener('click', () => enter(false));
    start.querySelector<HTMLButtonElement>('[data-start-multi]')!.addEventListener('click', (e) => {
      if (!server) {
        status.textContent = 'Multiplayer is coming soon. Single player has the whole city for now.';
        (e.currentTarget as HTMLElement).classList.add('is-nudged');
        return;
      }
      enter(true);
    });
    start.querySelector<HTMLButtonElement>('[data-start-single]')!.focus({ preventScroll: true });
  }
</script>
