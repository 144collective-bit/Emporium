---
/*
 * The homepage: Sector 7.
 *
 * Two layers. The 2D isometric map (src/lib/city.ts) renders on the server:
 * it's the no-WebGL fallback and the "2D map" view (the start menu covers
 * it while the 3D city loads: the owner wants no map on loading). On
 * top of it the 3D city (src/scripts/city3d) boots where WebGL is available:
 * buildings you hover and click, a camera that flies in, glass panels with
 * each section, day/night, weather and optional sound.
 *
 * All copy is DRAFT - see the note in the card and the panels.
 */
import { Image, Picture, getImage } from 'astro:assets';
import degen from '../assets/degen.png';
import logo from '../assets/logo.png';
import pulsechain from '../assets/pulsechain.png';
import { renderCity, VIEW, EMPORIUM_FOCUS, type Spot, type SpotId } from '../lib/city';
import { X_URL, X_HANDLE, TELEGRAM_URL, SHOP_URL, SHOP_OPEN } from '../data/site';

const [degenImg, logoImg, degenBig, logoBig] = await Promise.all([
  getImage({ src: degen, width: 160, format: 'webp' }),
  getImage({ src: logo, width: 440, format: 'webp' }),
  getImage({ src: degen, width: 520, format: 'webp' }),
  getImage({ src: logo, width: 729, format: 'webp' }),
]);

// The buildings are places in the city's game (each opens its own panel in 3D); none of them
// links off to the comic page or elsewhere. In the 2D map they point back to the city.
const spots: Record<SpotId, Spot> = {
  emporium: { href: '#city-title', title: 'The Emporium', sub: 'Market hall', aria: 'The Emporium: the market hall' },
  shop: { href: '#city-title', title: 'Drop 001', sub: 'Clothes · fitting room', aria: 'Drop 001: clothes and the fitting room' },
  workshop: { href: '#city-title', title: 'The Workshop', sub: 'Factory', aria: 'The Workshop: the factory' },
  vault: { href: '#city-title', title: 'The Vault', sub: 'Bank', aria: 'The Vault: the bank' },
  plan: { href: '#city-title', title: 'The Armoury', sub: 'Guns & gear', aria: 'The Armoury: guns and gear' },
  signal: { href: '#city-title', title: 'Signal tower', sub: 'News & contracts', aria: 'Signal tower: news and contracts' },
  telegram: { href: '#city-title', title: 'Post office', sub: 'Couriers', aria: 'Post office: couriers' },
  apartments: { href: '#city-title', title: 'Apartments', sub: 'Staff', aria: 'The Apartments: hire staff' },
  karts: { href: '#city-title', title: 'Kart park', sub: 'Go-karts · races', aria: 'The kart park: go-kart races' },
  airport: { href: '#city-title', title: 'Airport', sub: 'Hangar · fly', aria: 'Sector 7 Airport: fly your own aircraft' },
};
const directory: SpotId[] = ['emporium', 'shop', 'workshop', 'vault', 'plan', 'signal', 'telegram', 'apartments', 'karts', 'airport'];
const ext = { target: '_blank', rel: 'noopener noreferrer' };

const map = renderCity({ spots, art: { degen: degenImg.src, logo: logoImg.src } });
const focusX = +((EMPORIUM_FOCUS[0] - VIEW.x) / VIEW.w).toFixed(4);
const focusY = +((EMPORIUM_FOCUS[1] - VIEW.y) / VIEW.h).toFixed(4);
// The commit this was built from (set by the Worker's build in server/wrangler.jsonc)
// Connect wallet (account-ui.ts): only when the site has a game server
const server = !!import.meta.env.PUBLIC_GAME_SERVER;
const build = (import.meta.env.PUBLIC_BUILD as string | undefined)?.slice(0, 7) ?? '';
---

<section class="city has-start" aria-labelledby="city-title" data-city-root data-view="2d" data-mode="explore" data-degen={degenBig.src} data-logo={logoBig.src}>
  <div class="city-viewport" data-city data-focus-x={focusX} data-focus-y={focusY} tabindex="0" role="region" aria-label="City map: scroll or drag to look around">
    <svg class="city-map" viewBox={`${VIEW.x} ${VIEW.y} ${VIEW.w} ${VIEW.h}`} role="group" aria-label="Sector 7">
      <g set:html={map} />
    </svg>
  </div>

  {/* The 3D city: canvas is added by the script; pins float over their buildings */}
  <div class="city3d" data-city3d>
    <div class="city-pins">
      {directory.map((id) => (
        <button type="button" class="city-pin" data-pin={id} tabindex="-1" aria-hidden="true">
          <span class="city-pin-card">
            <span class="city-pin-title">{spots[id].title}</span>
            <span class="city-pin-sub">{spots[id].sub}</span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <div class="city-loader" data-loader hidden>
    <p class="kicker"><span class="kicker-num">3D</span> Entering Sector 7</p>
    <div class="city-loader-bar" data-loader-bar><span></span></div>
  </div>

  {/* The start menu (the owner's call): over everything on every open, while the 3D city loads behind it.
      Single player enters the city; Multiplayer joins other Degens when there's a game server (coming soon
      without one); Options holds time, weather, sound and the 2D map. Nothing of the map shows until you pick. */}
  <div class="city-start" data-start role="dialog" aria-modal="true" aria-label="Sector 7">
    <div class="city-start-card">
      <Picture src={logo} formats={['avif', 'webp']} fallbackFormat="webp" widths={[132, 264, 396]} sizes="132px" alt="" loading="eager" class="city-start-logo" />
      <p class="city-start-kicker">Welcome to</p>
      <p class="city-start-title">Sector <span class="hl">7</span></p>
      <div class="city-start-main" data-start-main>
        <button type="button" class="city-start-btn" data-start-single>
          <span class="city-start-btn-name">Single player</span>
          <span class="city-start-btn-sub">The whole city, in this browser</span>
        </button>
        <button type="button" class="city-start-btn" data-start-multi aria-disabled={server ? 'false' : 'true'}>
          <span class="city-start-btn-name">Multiplayer</span>
          <span class="city-start-btn-sub">{server ? 'Walk the city with other Degens' : 'Coming soon'}</span>
        </button>
        <button type="button" class="city-start-btn" data-start-options aria-expanded="false">
          <span class="city-start-btn-name">Options</span>
          <span class="city-start-btn-sub">Time, weather, sound, 2D map</span>
        </button>
      </div>
      <div class="city-start-options" data-start-pane hidden>
        <div class="city-start-row">
          <span class="city-start-label">Time</span>
          <div class="city-start-seg" role="group" aria-label="Time of day">
            <button type="button" data-opt="time" data-val="live" aria-pressed="true">Live</button>
            <button type="button" data-opt="time" data-val="day" aria-pressed="false">Day</button>
            <button type="button" data-opt="time" data-val="sunset" aria-pressed="false">Sunset</button>
            <button type="button" data-opt="time" data-val="night" aria-pressed="false">Night</button>
          </div>
        </div>
        <div class="city-start-row">
          <span class="city-start-label">Weather</span>
          <div class="city-start-seg" role="group" aria-label="Weather">
            <button type="button" data-opt="weather" data-val="auto" aria-pressed="true">Auto</button>
            <button type="button" data-opt="weather" data-val="clear" aria-pressed="false">Clear</button>
            <button type="button" data-opt="weather" data-val="rain" aria-pressed="false">Rain</button>
          </div>
        </div>
        <div class="city-start-row">
          <span class="city-start-label">Sound</span>
          <div class="city-start-seg" role="group" aria-label="Sound">
            <button type="button" data-opt="sound" data-val="off" aria-pressed="true">Off</button>
            <button type="button" data-opt="sound" data-val="on" aria-pressed="false">On</button>
          </div>
        </div>
        <div class="city-start-row">
          <span class="city-start-label">View</span>
          <div class="city-start-seg" role="group" aria-label="View">
            <button type="button" data-opt="view" data-val="3d" aria-pressed="true">3D city</button>
            <button type="button" data-opt="view" data-val="2d" aria-pressed="false">2D map</button>
          </div>
        </div>
        <button type="button" class="city-start-back" data-start-back>Back</button>
      </div>
      <p class="city-start-status" aria-live="polite"><span data-start-status>Loading the city…</span></p>
      <div class="city-start-bar" data-start-bar><span></span></div>
      <p class="city-start-note">Draft · v0{build && ` · ${build}`} · Everything in the city is its own game: Dorras, never real money.</p>
    </div>
  </div>

  {/* View settings, only while the 3D city is up */}

  {/* The mode header: which view you are in, the walk tabs while walking, and the City / Walk / Build switch.
       Its title and subtitle are painted by head.ts. */}
  <header class="city-head" data-city-head>
    <a href="/" class="city-head-logo" aria-label="The Degen Emporium, home">
      <Picture src={logo} formats={['avif', 'webp']} fallbackFormat="webp" widths={[72, 144, 216]} sizes="72px" alt="" loading="eager" class="city-head-logo-img" />
    </a>
    <div class="city-head-id">
      <p class="city-head-text"><b data-head-title>City map</b><small data-head-sub>2D view</small></p>
    </div>
    <div class="walk-top">
      <details class="walk-settings walk-pop" data-pop>
        <summary>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></svg>
          <span class="walk-pill-text">Controls</span>
        </summary>
        <div class="walk-settings-body">
          <div class="pop-head">
            <p class="pop-title">Controls</p>
            <button type="button" class="pop-close" data-pop-close aria-label="Close controls">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
            </button>
          </div>
          <p class="walk-section">Look</p>
          <label class="walk-field">
            <span>Look speed</span>
            <input type="range" data-walk-sens min="0.3" max="2.5" step="0.1" value="1" />
          </label>
          <label class="walk-check">
            <input type="checkbox" data-walk-invert />
            <span>Invert look up / down</span>
          </label>
          <button type="button" class="walk-fp" data-walk-fp aria-pressed="true">First person</button>
          <p class="walk-section">Shooting</p>
          <div class="walk-field" role="group" aria-labelledby="auto-ads-label">
            <span id="auto-ads-label">Aim when firing</span>
            <div class="walk-seg">
              <button type="button" data-auto-ads="off" aria-pressed="true">Off</button>
              <button type="button" data-auto-ads="touch" aria-pressed="false">Touch only</button>
              <button type="button" data-auto-ads="always" aria-pressed="false">Always</button>
            </div>
            <p class="walk-pad">Firing brings the gun up to the sight (steadier shots), and it drops again when you stop. Touch only: the on-screen Fire button.</p>
          </div>
          <dl class="walk-keys">
            <dt><kbd>WASD</kbd></dt><dd>Move</dd>
            <dt><kbd>Mouse</kbd></dt><dd>Look around</dd>
            <dt><kbd>Shift</kbd></dt><dd>Run (hold)</dd>
            <dt><kbd>Caps&nbsp;Lock</kbd></dt><dd>Run (toggle)</dd>
            <dt><kbd>Space</kbd></dt><dd>Jump (hold for higher)</dd>
            <dt><kbd>Right&nbsp;click</kbd></dt><dd>Aim (red dot sight)</dd>
            <dt><kbd>V</kbd></dt><dd>First / third person</dd>
            <dt><kbd>Scroll</kbd></dt><dd>Camera distance</dd>
            <dt><kbd>E</kbd></dt><dd>Enter a door, open the gun store, the garage or the race board, get in / out of your car</dd>
            <dt><kbd>Click</kbd></dt><dd>Fire (once geared up)</dd>
            <dt><kbd>R</kbd></dt><dd>Reload</dd>
            <dt><kbd>Q</kbd> <kbd>1</kbd>–<kbd>7</kbd></dt><dd>Swap gun (next, or by number)</dd>
            <dt><kbd>G</kbd></dt><dd>Holster / draw</dd>
            <dt><kbd>T</kbd></dt><dd>Emotes and phrases (online)</dd>
            <dt><kbd>Esc</kbd></dt><dd>Free the mouse, then stop</dd>
          </dl>
          <p class="walk-pad">Driving: <kbd>W</kbd> / <kbd>S</kbd> gas and brake (hold to reverse), <kbd>A</kbd> / <kbd>D</kbd> steer, <kbd>Space</kbd> handbrake, <kbd>V</kbd> chase or roof camera. Your car waits on the turntable at the garage on the south bank. Gamepad: RT gas, LT brake, A handbrake, Y get out. Touch: the stick steers, with Gas and Brake buttons.</p>
          <p class="walk-pad">Gear up at the gun store counter inside the Armoury. Gamepads work too: left stick moves, right stick looks, A jumps, LB runs, LT aims, RT fires, X reloads, RB swaps guns. On a touch screen, drag the Fire button to aim while you shoot. Your look and rifle finish are in Profile.</p>
        </div>
      </details>
      <details class="walk-pop walk-profile" data-pop data-profile>
        <summary aria-label="Profile">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
          <span class="walk-pill-text">Profile</span>
        </summary>
        <div class="walk-settings-body">
          <div class="pop-head">
            <p class="pop-title">Profile</p>
            <button type="button" class="pop-close" data-pop-close aria-label="Close profile">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
            </button>
          </div>
          <div class="profile-head">
            <p class="profile-name"><b data-profile-name>Degen</b> <span class="mp-rank" data-profile-rank data-rank="rookie">Rookie</span></p>
            <button type="button" class="walk-fp" data-profile-rename hidden>New name</button>
            <button type="button" class="walk-fp" data-account-open hidden>Log in with wallet</button>
            <p class="walk-pad" data-profile-note>Go online to get your player name. Your look and rifle finish are saved in this browser.</p>
          </div>
          <div class="walk-skins" data-skins>
            <p class="walk-skins-head"><span>Rifle finish</span><span>Lifetime score <b data-lifetime>0</b></span></p>
            <div class="walk-skins-row">
              <button type="button" data-skin="olive" aria-pressed="true"><i class="sw sw-olive"></i>Field Olive<small>Equipped</small></button>
              <button type="button" data-skin="ink" aria-pressed="false" disabled><i class="sw sw-ink"></i>Black Ink<small>2,500 pts</small></button>
              <button type="button" data-skin="neon" aria-pressed="false" disabled><i class="sw sw-neon"></i>Pulse Neon<small>10,000 pts</small></button>
            </div>
          </div>
          <div class="wardrobe" data-wardrobe>
            <p class="walk-skins-head"><span>Wardrobe</span></p>
            <p class="walk-pad">Pick your fit, headwear, bag and kicks in the fitting room at Drop 001.</p>
            <button type="button" class="walk-fp" data-open-fitting>Open the fitting room</button>
          </div>
          {/* Level, XP and badges (missions-ui.ts) */}
          <div class="walk-badges" data-badges></div>
        </div>
      </details>
      <details class="walk-pop walk-online" data-pop data-mp hidden>
        <summary aria-label="Multiplayer">
          <i class="mp-dot" data-mp-dot aria-hidden="true"></i>
          <span class="walk-pill-text" data-mp-label>Go online</span>
        </summary>
        <div class="walk-settings-body">
          <div class="pop-head">
            <p class="pop-title">Online</p>
            <button type="button" class="pop-close" data-pop-close aria-label="Close multiplayer">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
            </button>
          </div>
          <p class="walk-skins-head"><span>Multiplayer (beta)</span><span data-mp-ping></span></p>
          <p class="mp-status" data-mp-status>Walk the city with other Degens. Emotes and set phrases only, nothing typed.</p>
          <button type="button" class="walk-fp" data-mp-join>Go online</button>
          <ul class="mp-list" data-mp-list></ul>
        </div>
      </details>
      <details class="walk-pop walk-emotes" data-pop data-emotes hidden>
        <summary aria-label="Emotes and phrases">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" /></svg>
          <span class="walk-pill-text">Emote</span>
        </summary>
        <div class="walk-settings-body">
          <div class="pop-head">
            <p class="pop-title">Emotes</p>
            <button type="button" class="pop-close" data-pop-close aria-label="Close emotes">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
            </button>
          </div>
          <div class="emote-grid" data-emote-grid></div>
          <div class="phrase-grid" data-phrase-grid></div>
          <p class="walk-pad">Press T to open this. Others see a bubble over your head.</p>
        </div>
      </details>
    </div>
    {/* Walking with a gun: ammo and score (combat.ts paints them) */}
    <div class="city-head-stats" aria-live="off">
      <div class="combat-ammo"><b data-mag>30</b><span>/ <span data-reserve>120</span></span><small class="combat-gun" data-gun>Assault Rifle</small><small data-reload-hint hidden>R to reload</small></div>
      <div class="combat-score">Score <b data-score>0</b><small data-streak hidden></small></div>
    </div>
    {/* Online / Offline (online.ts): only when the site is built with a game server */}
    <div class="city-online" data-online-switch role="group" aria-label="Online or offline" hidden>
      <i class="mp-dot" data-online-dot data-state="off" aria-hidden="true"></i>
      <button type="button" data-online-set="on" aria-pressed="true">On<span class="city-online-long">line</span></button>
      <button type="button" data-online-set="off" aria-pressed="false">Off<span class="city-online-long">line</span></button>
    </div>
    <div class="city-head-modes" role="group" aria-label="View mode">
      <button type="button" class="city-to3d" data-view-toggle="3d" hidden>
        <span aria-hidden="true">◆</span> Enter 3D city
      </button>
      <button type="button" class="city-mode-btn" data-mode-city aria-pressed="true" hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V9l5-3v15M10 21V4l9 4v13M14 10h2M14 14h2M7 12h1M7 16h1" /></svg>
        <span class="city-mode-label">City</span>
      </button>
      <button type="button" class="city-mode-btn" data-walk-toggle aria-pressed="false" hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="13" cy="4" r="2" /><path d="M9 20l2-6 3 3v4M7 12l3-4 4 1 2 4M11 14l-2-2" /></svg>
        <span class="city-mode-label" data-walk-label>Walk</span>
      </button>
      <button type="button" class="city-mode-btn" data-build-toggle aria-pressed="false" hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><path d="M17.5 14v7M14 17.5h7" /></svg>
        <span class="city-mode-label" data-build-label>Build</span>
      </button>
    </div>
    {/* Settings and the menu (directory, PulseChain native, X, Telegram), and Connect wallet when there's a game server */}
    <div class="city-head-tools">
      {/* Your Dorras (tycoon-ui.ts): opens your stall's card; a dot when the till has takings */}
      <button type="button" class="dorras-pill" data-dorras aria-label="Dorras: open your stall">
        <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" opacity=".18" /><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" /><path d="M9 7h3.5a5 5 0 0 1 0 10H9zM7 12h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span class="dorras-amount" data-dorras-amount>0</span>
        <i class="dorras-dot" aria-hidden="true"></i>
      </button>
      {/* Your level (missions-ui.ts): "Lv 7" over its XP bar. Drops a card in the city; while walking it opens the Profile tab's badges. */}
      <details class="head-pop level-pop" data-level>
        <summary aria-label="Level 1, Newcomer" title="Newcomer">
          <span class="level-tag" data-level-tag>Lv 1</span>
          <i class="level-bar" data-level-bar style="--v:0" aria-hidden="true"></i>
        </summary>
        <div class="head-panel level-panel">
          <div class="pop-head">
            <p class="pop-title">Your level</p>
            <button type="button" class="pop-close" data-pop-close aria-label="Close your level">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
            </button>
          </div>
          <div class="level-body" data-level-body></div>
        </div>
      </details>
      {server && (
        <button type="button" class="nav-account" data-account-nav aria-label="Connect your wallet" onclick="this.dataset.wanted='1'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H18v4" /><path d="M3 7.5v10A2.5 2.5 0 0 0 5.5 20H20V9H5.5A2.5 2.5 0 0 1 3 7.5z" /><circle cx="16" cy="14.5" r="1.2" /></svg>
          <span class="nav-account-label" data-account-label>Connect<span class="nav-account-more"> wallet</span></span>
        </button>
      )}
      {/* Build mode: your plots (what you own, your Dorras, the next plot's price), painted by builder-ui.ts */}
      <details class="head-pop builder-pop" data-builder-bar hidden>
        <summary aria-label="Plots">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-6 9 6v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" /><path d="M9 21v-7h6v7" /></svg>
          <span class="head-btn-text" data-plots-label>Plots</span>
        </summary>
        <div class="head-panel builder-wallet-panel">
          <div class="pop-head">
            <p class="pop-title">Your plots</p>
            <button type="button" class="pop-close" data-pop-close aria-label="Close plots">
