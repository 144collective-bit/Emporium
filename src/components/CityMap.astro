  <div class="city-hud" data-city-hud>
    <div class="city-card" id="city-card">
      <button type="button" class="city-card-close" data-card-close aria-controls="city-card" aria-label="Hide the welcome card">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
      </button>
      <p class="kicker"><span class="kicker-num">GM</span> PulseChain native</p>
      <h1 id="city-title" class="city-title">Welcome to <span class="hl">Degen&nbsp;City</span></h1>
      <p class="city-hint"><span class="hint-2d">Drag to look around. Pick a lit-up building to go in.</span><span class="hint-3d">Drag to move, two fingers or right-drag to turn, pinch or scroll to zoom. Tap a building to go in.</span></p>
      <p class="city-draft">Draft · v0 · nothing here is final</p>
    </div>

    <details class="city-dir">
      <summary>Directory</summary>
      <ul>
        {directory.map((id) => {
          const s = spots[id];
          return (
            <li>
              <a href={s.href} data-dir-spot={id} {...(s.external ? ext : {})}>
                <span>{s.title}</span>
                <small>{s.sub}</small>
              </a>
            </li>
          );
        })}
      </ul>
    </details>

    {/* Stands in for the card's draft note when the card is hidden (always on phones) */}
    <p class="city-draft-tag">Draft · v0</p>
  </div>
  {/* Keep a closed welcome card closed on return, before first paint so it doesn't flash */}
  <script is:inline>
    try {
      if (localStorage.getItem('city-card') === 'hidden') {
        document.querySelector('[data-city-hud]').dataset.card = 'hidden';
      }
    } catch {}
  </script>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-city-root]');
  const vp = document.querySelector<HTMLElement>('[data-city]');
  const svg = vp?.querySelector('svg');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && vp && svg) {
    // Open on the Emporium
    vp.scrollLeft = svg.clientWidth * Number(vp.dataset.focusX) - vp.clientWidth / 2;
    vp.scrollTop = svg.clientHeight * Number(vp.dataset.focusY) - vp.clientHeight / 2;

    // Drag to pan with a mouse; touch and trackpads scroll natively
    let drag: { x: number; y: number; left: number; top: number } | null = null;
    let moved = false;
    vp.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, y: e.clientY, left: vp.scrollLeft, top: vp.scrollTop };
      moved = false;
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!moved && Math.hypot(dx, dy) > 5) {
        moved = true;
        vp.classList.add('is-dragging');
      }
      if (moved) {
        vp.scrollLeft = drag.left - dx;
        vp.scrollTop = drag.top - dy;
      }
    });
    window.addEventListener('pointerup', () => {
      drag = null;
      vp.classList.remove('is-dragging');
    });
    // A drag that ends on a building is not a click
    vp.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true
    );
    vp.addEventListener('dragstart', (e) => e.preventDefault());

    // A building and its pin light up together
    const hot = (id: string, on: boolean) =>
      vp.querySelectorAll(`[data-spot="${id}"]`).forEach((el) => el.classList.toggle('is-hot', on));
    vp.querySelectorAll<SVGElement>('[data-spot]').forEach((el) => {
      const id = el.dataset.spot!;
      el.addEventListener('pointerenter', () => hot(id, true));
      el.addEventListener('pointerleave', () => hot(id, false));
      el.addEventListener('focus', () => hot(id, true));
      el.addEventListener('blur', () => hot(id, false));
    });

    // Tablets and desktops: the welcome card can be closed, and stays closed on return
    document.querySelector('[data-card-close]')?.addEventListener('click', () => {
      const hud = document.querySelector<HTMLElement>('[data-city-hud]')!;
      hud.dataset.card = 'hidden';
      try {
        localStorage.setItem('city-card', 'hidden');
      } catch {}
      vp.focus({ preventScroll: true });
    });

    // Drop-open menus (City settings, Directory, walk mode's panels) close with their ×, a tap
    // outside or Esc (in 3D, index.ts handles Esc so it can come before leaving a mode)
    const openMenus = () => root.querySelectorAll<HTMLDetailsElement>('.city-controls[open], .city-dir[open], [data-pop][open]');
    root.addEventListener('click', (e) => {
      const menu = (e.target as HTMLElement).closest('[data-pop-close]')?.closest('details');
      if (!menu) return;
      menu.open = false;
      menu.querySelector('summary')?.focus({ preventScroll: true });
    });
    document.addEventListener(
      'pointerdown',
      (e) => {
        for (const menu of openMenus()) if (!menu.contains(e.target as Node)) menu.open = false;
      },
      true,
    );
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || root.dataset.view === '3d') return;
      openMenus().forEach((menu) => (menu.open = false));
    });

    // SMIL animations (cars, rings, the plane) ignore CSS, so pause them here
    if (reduced) svg.pauseAnimations();

    /* ---------- The 3D city ---------- */
    const controls = root.querySelector<HTMLDetailsElement>('[data-controls]')!;
    const to3d = root.querySelector<HTMLButtonElement>('.city-to3d')!;
    let city: { stop(): void; start(): void } | null = null;
    let booting = false;
    const remember = (v: string) => {
      try {
        localStorage.setItem('city-view', v);
      } catch {}
    };

    async function go3d() {
      if (booting) return;
      if (city) {
        city.start();
        root!.dataset.view = '3d';
      } else {
        booting = true;
        const { bootCity } = await import('../scripts/city3d/index');
        city = await bootCity(root!);
        booting = false;
        if (!city) return show2d(false);
      }
      svg!.pauseAnimations();
      to3d.hidden = true;
      if (innerWidth > 900) controls.open = true;
    }
    function show2d(offer: boolean) {
      city?.stop();
      root!.dataset.view = '2d';
      to3d.hidden = !offer;
      if (!reduced) svg!.unpauseAnimations();
    }
    root.querySelectorAll<HTMLButtonElement>('[data-view-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        remember(b.dataset.viewToggle!);
        if (b.dataset.viewToggle === '3d') go3d();
        else show2d(true);
      })
    );

    // Boot 3D where WebGL2 works, unless the visitor chose the 2D map
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('city-view');
    } catch {}
    const gl = document.createElement('canvas').getContext('webgl2');
    gl?.getExtension('WEBGL_lose_context')?.loseContext();
    if (!gl) to3d.remove();
    else if (saved === '2d') to3d.hidden = false;
    else go3d();
  }
</script>
