    <button type="button" class="chip-link kart-walkin" data-tower-walkin>Walk in</button>
  </template>

  <template data-panel-tpl="palmcourt">
    <p class="kicker"><span class="kicker-num">19</span> North of downtown</p>
    <h2 id="city-panel-title" class="city-panel-title">Palm Court</h2>
    <p class="city-panel-text">An open-air shopping street by Westlake Park. Two rows of shops in glass, white render, cladding and timber face each other down a stone-paved promenade lined with trees: coffee, fashion, books, homeware, a bakery, sneakers, a grill and more, with festoon lights strung overhead. Paradise Cinema closes the north end, a water feature sits in the middle, and the park's east gates open straight onto it. Across the avenue is Starlight Mall. The shops open later: coming soon.</p>
    <button type="button" class="chip-link kart-walkin" data-palmcourt-walkin>Walk in</button>
