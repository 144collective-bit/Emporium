</section>

<script>
  import { live } from '../scripts/city3d/live-client';
  import { bannersAt, type Live } from '../scripts/city3d/live';

  const root = document.querySelector<HTMLElement>('[data-city-root]');

  if (root) {
    // The owner's live settings (live.ts): asked for now; the 3D city's boot waits for them (briefly)
    const liveFirst = live.start();
    // WebGL2 here? (the 3D city needs it; without it the page says so, [data-no3d]). Only asked of the browser: a
    // context made to test and thrown away cost a phone a second context's start-up (and the GPU's memory for it);
    // where the browser has WebGL 2 but no context can be made, the renderer's own fails and bootCity() says so
    const gl = 'WebGL2RenderingContext' in window;
    // ?anim (the animation lab, anim-lab.ts) opens over the page with no city behind it: not a missing 3D
    const lab = new URLSearchParams(location.search).has('anim');

    // Tablets and desktops: the welcome card can be closed, and stays closed on return
    document.querySelector('[data-card-close]')?.addEventListener('click', () => {
      const hud = document.querySelector<HTMLElement>('[data-city-hud]')!;
      hud.dataset.card = 'hidden';
      try {
        localStorage.setItem('city-card', 'hidden');
      } catch {}
      root.querySelector<HTMLElement>('[data-city3d] canvas')?.focus({ preventScroll: true });
    });

    // Drop-open menus (City settings, Directory, walk mode's panels) close with their ×, a tap
    // outside or Esc (in 3D, index.ts handles Esc so it can come before leaving a mode)
    const openMenus = () => root.querySelectorAll<HTMLDetailsElement>('.head-pop[open], [data-pop][open]');
    // One drop-down at a time (the header's settings and menu, walk mode's panels)
    const pops = root.querySelectorAll<HTMLDetailsElement>('.head-pop, [data-pop]');
    pops.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) pops.forEach((o) => o !== d && (o.open = false));
      })
    );
    root.addEventListener('click', (e) => {
      const menu = (e.target as HTMLElement).closest('[data-pop-close]')?.closest('details');
      if (!menu) return;
      menu.open = false;
      menu.querySelector('summary')?.focus({ preventScroll: true });
    });
    document.addEventListener(
      'pointerdown',
      (e) => {
        for (const menu of openMenus()) if (!menu.contains(e.target as Node)) menu.open = false;
      },
      true,
    );
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || root.dataset.view === '3d') return;
      openMenus().forEach((menu) => (menu.open = false));
    });

    /* ---------- Connect wallet (made with the page; the 3D city plugs in when it starts) ---------- */
    const server = import.meta.env.PUBLIC_GAME_SERVER as string | undefined;
    const wallet = server
      ? Promise.all([import('../scripts/city3d/account'), import('../scripts/city3d/account-ui')]).then(([{ createAccount }, { createAccountUI }]) => {
          const account = createAccount(server);
          const online = () => {
            try {
              return localStorage.getItem('degen-city-online-v1') !== 'off';
            } catch {
              return true;
            }
          };
          const hooks = {
            online,
            goOnline() {
              try {
                localStorage.setItem('degen-city-online-v1', 'on');
              } catch {}
            },
            rename: () => account.rename(),
            opened() {},
          };
          if (account.address && online()) account.refresh();
          return { account, hooks, ui: createAccountUI(root, account, hooks) };
        })
      : Promise.resolve(null);

    /* ---------- The 3D city ---------- */
    let city: { stop(): void; start(): void; open(id: string): void; intro(): void } | null = null;
    let booting = false;
    const NO_3D = 'Sector 7 needs a device with 3D graphics (WebGL 2).';
    /** No 3D here: the page says so, and so does the start menu (the header's Menu keeps the comic page and the links) */
    function no3d() {
      root!.dataset.view = 'none';
      root!.querySelector<HTMLElement>('[data-no3d]')!.hidden = false;
      // (the header's copy is head.ts's once the 3D city has started; before that, it's here)
      const sub = root!.querySelector<HTMLElement>('[data-head-sub]');
      if (sub) sub.textContent = 'Needs 3D graphics';
      root!.querySelector<HTMLElement>('[data-start-status]')!.textContent = NO_3D;
      root!.querySelector<HTMLElement>('[data-start-bar]')!.hidden = true;
      root!.querySelector<HTMLElement>('[data-start-single] .city-start-btn-sub')!.textContent = 'Needs 3D graphics';
    }

    async function go3d() {
      if (booting || city) return;
      if (!gl) return no3d();
      // (never behind the maintenance cover: the page reloads when it lifts)
      await liveFirst;
      if (live.now.maintenance) return;
      booting = true;
      try {
        const { bootCity } = await import('../scripts/city3d/index');
        city = await bootCity(root!, await wallet);
      } catch (err) {
        console.error(err);
      }
      booting = false;
      if (!city) return lab ? undefined : no3d();
      // Options picked in the start menu before the city was up
      for (const apply of pendingOpts.splice(0)) apply();
    }

    // Boot the 3D city straight away, behind the start menu
    /** Resolves once the first boot has settled (the 3D city is up, or the page says it can't be) */
    const booted: Promise<unknown> = go3d();

    /* ---------- The start menu ---------- */
    const start = root.querySelector<HTMLElement>('[data-start]')!;
    const startMain = start.querySelector<HTMLElement>('[data-start-main]')!;
    const startPane = start.querySelector<HTMLElement>('[data-start-pane]')!;
    const optionsBtn = start.querySelector<HTMLButtonElement>('[data-start-options]')!;
    const status = start.querySelector<HTMLElement>('[data-start-status]')!;
    const startBar = start.querySelector<HTMLElement>('[data-start-bar]')!;
    const loaderBar = root.querySelector<HTMLElement>('[data-loader-bar]')!;
    const loaderEl = root.querySelector<HTMLElement>('[data-loader]')!;
    /** Option choices made before the 3D city was up, applied when it is (its header controls do the work) */
    const pendingOpts: (() => void)[] = [];
    let entering = false;
    let closed = false;

    // The loader's progress, mirrored under the menu
    new MutationObserver(() => startBar.style.setProperty('--p', loaderBar.style.getPropertyValue('--p') || '0')).observe(loaderBar, { attributes: true, attributeFilter: ['style'] });
    new MutationObserver(() => {
      if (loaderEl.classList.contains('is-done')) {
        startBar.style.setProperty('--p', '1');
        if (!entering) status.textContent = 'The city is ready.';
      }
    }).observe(loaderEl, { attributes: true, attributeFilter: ['class'] });

    function paintOpt(opt: string, val: string) {
      start.querySelectorAll<HTMLButtonElement>(`[data-opt="${opt}"]`).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.val === val)));
    }
    /** An option is the header's own control, pressed now or once the city is up */
    function applyOpt(opt: string, val: string) {
      const run = () => {
        if (opt === 'sound') {
          const b = root!.querySelector<HTMLButtonElement>('[data-controls] [data-sound]');
          if (b && b.getAttribute('aria-pressed') !== String(val === 'on')) b.click();
        } else root!.querySelector<HTMLButtonElement>(`[data-controls] [data-${opt}="${val}"]`)?.click();
      };
      if (city) run();
      else pendingOpts.push(run);
    }
    start.querySelectorAll<HTMLButtonElement>('[data-opt]').forEach((b) =>
      b.addEventListener('click', () => {
        const opt = b.dataset.opt!;
        const val = b.dataset.val!;
        paintOpt(opt, val);
        applyOpt(opt, val);
      })
    );
    // The header's sound button is the one that knows (it needs a tap to start): mirror it
    const headSound = root.querySelector<HTMLButtonElement>('[data-controls] [data-sound]');
    if (headSound) new MutationObserver(() => paintOpt('sound', headSound.getAttribute('aria-pressed') === 'true' ? 'on' : 'off')).observe(headSound, { attributes: true, attributeFilter: ['aria-pressed'] });

    function showPane(on: boolean) {
      startPane.hidden = !on;
      startMain.hidden = on;
      optionsBtn.setAttribute('aria-expanded', String(on));
      (on ? startPane.querySelector<HTMLButtonElement>('button') : optionsBtn)?.focus({ preventScroll: true });
    }
    optionsBtn.addEventListener('click', () => showPane(true));
    start.querySelector('[data-start-back]')!.addEventListener('click', () => showPane(false));
    start.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !startPane.hidden) {
        e.stopPropagation();
        showPane(false);
      }
    });

    function closeStart() {
      if (closed) return;
      closed = true;
      root!.classList.remove('has-start');
      start.classList.add('is-done');
      start.setAttribute('aria-hidden', 'true');
      setTimeout(() => (start.hidden = true), 450);
    }
    /** Into the city with its fly-in once it's up; with no 3D here, onto the page that says so */
    async function enter(multi: boolean) {
      if (entering) return;
      entering = true;
      status.textContent = gl ? 'Entering…' : NO_3D;
      await booted;
      if (multi && server && city) root!.querySelector<HTMLButtonElement>('[data-online-set="on"]')?.click();
      closeStart();
      if (city) city.intro();
      entering = false;
    }
    start.querySelector('[data-start-single]')!.addEventListener('click', () => enter(false));
    start.querySelector<HTMLButtonElement>('[data-start-multi]')!.addEventListener('click', (e) => {
      if (!server) {
        status.textContent = 'Multiplayer is coming soon. Single player has the whole city for now.';
        (e.currentTarget as HTMLElement).classList.add('is-nudged');
        return;
      }
      enter(true);
    });
    start.querySelector<HTMLButtonElement>('[data-start-single]')!.focus({ preventScroll: true });

    /* ---------- Live settings: maintenance and the owner's notice ---------- */
    const maint = root.querySelector<HTMLElement>('[data-maint]')!;
    const banner = root.querySelector<HTMLElement>('[data-live-banner]')!;
    const bannerText = banner.querySelector<HTMLElement>('[data-live-banner-text]')!;
    const bannerGo = banner.querySelector<HTMLButtonElement>('[data-live-banner-go]')!;
    const SEEN = 'degen-city-notices-v1';
    let seen: string[] = [];
    try {
      seen = JSON.parse(localStorage.getItem(SEEN) ?? '[]');
      if (!Array.isArray(seen)) seen = [];
    } catch {}
    /** A notice is hidden for good by its id and its words (new words under the same id show again) */
    const noticeKey = (b: { id: string; text: string }) => `${b.id}:${b.text.length}:${[...b.text].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)}`;
    let showing: ReturnType<typeof bannersAt>[number] | null = null;
    function paintBanner(l: Live) {
      showing = bannersAt(l, Date.now()).find((b) => !seen.includes(noticeKey(b))) ?? null;
      banner.hidden = !showing;
      if (!showing) return;
      bannerText.textContent = showing.text;
      bannerGo.hidden = !showing.place;
    }
    banner.querySelector('[data-live-banner-close]')!.addEventListener('click', () => {
      if (!showing) return;
      seen = [...seen.filter((k) => k !== noticeKey(showing!)), noticeKey(showing)].slice(-50);
      try {
        localStorage.setItem(SEEN, JSON.stringify(seen));
      } catch {}
      paintBanner(live.now);
    });
    bannerGo.addEventListener('click', async () => {
      const place = showing?.place;
      if (!place) return;
      if (!city) await go3d();
      city?.open(place);
    });
    let maintShown = false;
    function paintMaint(l: Live) {
      const m = l.maintenance;
      if (!m) {
        // It's lifted: start again, into the city as it is now
        if (maintShown) location.reload();
        return;
      }
      maintShown = true;
      maint.querySelector('[data-maint-text]')!.textContent = m.message;
      const eta = maint.querySelector<HTMLElement>('[data-maint-eta]')!;
      eta.hidden = !m.eta || m.eta < Date.now();
      if (m.eta) eta.textContent = `Expected back ${new Date(m.eta).toLocaleString([], { weekday: 'short', hour: 'numeric', minute: '2-digit' })}`;
      city?.stop();
      maint.hidden = false;
      root!.classList.add('has-maint');
    }
    let checked = false;
    liveFirst.then(() => (checked = true));
    const paintLive = (l: Live) => {
      if (!checked) return paintBanner(l);
      paintMaint(l);
      paintBanner(l);
    };
    // (the cover waits for the first check, so an old copy never flashes it up)
    paintBanner(live.now);
    liveFirst.then(() => paintLive(live.now));
    live.onChange(paintLive);
    // (a notice's from and until come round on their own)
    setInterval(() => paintBanner(live.now), 60_000);
    // ?bench (the benchmark, bench.ts): straight into the 3D city, no menu
    if (new URLSearchParams(location.search).has('bench') && gl) enter(false);
  }
</script>
