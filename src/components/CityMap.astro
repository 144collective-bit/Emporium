  </template>
  <template data-panel-tpl="bar">
    <p class="kicker"><span class="kicker-num">15</span> The Trenches</p>
    <h2 id="city-panel-title" class="city-panel-title">The Rusty Nail</h2>
    <p class="city-panel-text">A dive bar in an old brick walk-up on the corner, facing the boardwalk and the river: a dark wood front, warm windows and its name in neon. Pull up a stool later: coming soon.</p>
    <button type="button" class="chip-link kart-walkin" data-avenue-walkin="bar">Walk in</button>
  </template>
  <template data-panel-tpl="arms">
    <p class="kicker"><span class="kicker-num">16</span> The Trenches</p>
