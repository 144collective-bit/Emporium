  <div class="city-hud" data-city-hud>
    {/* First-visit tip under the header (closes for good with its ×; never on phones) */}
    <div class="city-card" id="city-card">
      <p class="kicker"><span class="kicker-num">GM</span></p>
      <h1 id="city-title" class="city-title">Welcome to <span class="hl">Sector&nbsp;7</span></h1>
      <p class="city-hint"><span class="hint-2d">Drag to look around. Pick a lit-up building to go in.</span><span class="hint-3d">Drag to move, right-drag to turn, scroll to zoom. Click a building to go in.</span></p>
      <p class="city-draft">Draft · v0</p>
      <button type="button" class="city-card-close" data-card-close aria-controls="city-card" aria-label="Hide the welcome tip">
