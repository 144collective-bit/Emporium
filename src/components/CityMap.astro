---
/*
 * The homepage: The Trenches, the game, set in the city of Sector 7.
 *
 * The 3D city (src/scripts/city3d) boots behind the start menu: buildings
 * you hover and click, a camera that flies in, glass panels with each
 * section, day/night, weather and optional sound. Where it can't run (no
 * WebGL 2, or the boot fails) the page says the city needs 3D graphics
 * (`[data-no3d]`); the 2D map it once fell back to was retired (the owner's call).
 *
 * All copy is DRAFT - see the note in the card and the panels.
 */
import { Image, Picture, getImage } from 'astro:assets';
import degen from '../assets/degen.png';
import logo from '../assets/logo.png';
import pulsechain from '../assets/pulsechain.png';
import flame from '../assets/liberty-flame.png';
import trenches from '../assets/trenches-logo.png';
import { TC_ICONS, tcIconPath } from '../data/tcicons';
import { KEYMAP, MODE_IDS } from '../scripts/city3d/keymap';
import type { Spot, SpotId } from '../lib/city';
import { X_URL, X_HANDLE, TELEGRAM_URL, SHOP_URL, SHOP_OPEN } from '../data/site';

// Art the 3D city loads (index.ts reads it from the root's data-degen, data-logo and data-flame)
const [degenBig, logoBig, flameImg] = await Promise.all([
  getImage({ src: degen, width: 520, format: 'webp' }),
  getImage({ src: logo, width: 729, format: 'webp' }),
  // The Liberty flame on Liberty Bridge's crowns (libertybridge.ts)
  getImage({ src: flame, width: 248, format: 'webp' }),
]);

// The buildings are places in the city's game (each opens its own panel in 3D); none of them
// links off to the comic page or elsewhere.
const spots: Record<SpotId, Spot> = {
  emporium: { title: 'The Emporium', sub: 'Market hall' },
  shop: { title: 'Drop 001', sub: 'Clothes · fitting room' },
  workshop: { title: 'The Workshop', sub: 'Factory' },
  vault: { title: 'The Vault', sub: 'Bank' },
  plan: { title: 'The Armoury', sub: 'Guns & gear' },
  signal: { title: 'Signal tower', sub: 'News & contracts' },
  telegram: { title: 'Post office', sub: 'Couriers' },
  apartments: { title: 'Apartments', sub: 'Staff' },
  karts: { title: 'Kart park', sub: 'Go-karts · races' },
  airport: { title: 'Airport', sub: 'Hangar · fly' },
  fightclub: { title: 'Fight Club', sub: 'Spar · bouts' },
  liberty: { title: 'Liberty Bridge', sub: 'Footbridge' },
  harbour: { title: 'Harbour Bridge', sub: 'The east avenue' },
  trenches: { title: 'The Block', sub: 'The Trenches' },
  club: { title: 'Club PULSE', sub: 'Nightclub · coming soon' },
  bar: { title: 'The Rusty Nail', sub: 'Bar · coming soon' },
  arms: { title: 'Trench Arms', sub: 'Guns & gear' },
  pier: { title: 'Pier 7', sub: 'The waterfront' },
  nightmarket: { title: 'Night Market', sub: 'Street food' },
  stadium: { title: 'Sector 7 Stadium', sub: 'Events · coming soon' },
  tower: { title: 'Sector 7 Tower', sub: 'Sky deck' },
  palmcourt: { title: 'Palm Court', sub: 'Shopping plaza' },
  mall: { title: 'Starlight Mall', sub: 'Shopping mall' },
  hotel: { title: 'The Coralline', sub: 'Grand hotel' },
  civichall: { title: 'Civic Hall', sub: 'Crestmont' },
  golfclub: { title: 'Crestmont Hills Club', sub: 'Country club' },
  overlook: { title: 'The Overlook', sub: 'The view' },
  reservoir: { title: 'The Reservoir', sub: 'In the hills' },
  harbourmaster: { title: 'Harbour Master', sub: 'Southbank Docks' },
  sunclub: { title: 'Sunridge Club', sub: 'Pool & clubhouse' },
  sunpark: { title: 'Sunridge Park', sub: 'Playground' },
  sunschool: { title: 'Sunridge Elementary', sub: 'School' },
  wildace: { title: 'Wild Ace', sub: 'Neon casino' },
  dragonspire: { title: 'Dragonspire', sub: 'Castle resort' },
  scarab: { title: 'The Golden Scarab', sub: 'Pyramid resort' },
  bigcity: { title: 'Big City', sub: 'Skyline resort' },
  gondolier: { title: 'The Gondolier', sub: 'Canal palace' },
  lagoon: { title: 'Lava Lagoon', sub: 'Lagoon resort' },
  orbit: { title: 'Orbit', sub: 'Space-age tower' },
  sphere: { title: 'The Sphere', sub: 'Shows' },
  lot9: { title: 'Lot 9', sub: 'Trailer park' },
};
const directory: SpotId[] = ['emporium', 'shop', 'workshop', 'vault', 'plan', 'signal', 'telegram', 'apartments', 'karts', 'airport', 'fightclub', 'liberty', 'harbour', 'trenches', 'club', 'bar', 'arms', 'pier', 'nightmarket', 'stadium', 'tower', 'palmcourt', 'mall', 'hotel', 'civichall', 'golfclub', 'overlook', 'reservoir', 'harbourmaster', 'sunclub', 'sunpark', 'sunschool', 'wildace', 'dragonspire', 'scarab', 'bigcity', 'gondolier', 'lagoon', 'orbit', 'sphere', 'lot9'];
const ext = { target: '_blank', rel: 'noopener noreferrer' };

// The commit this was built from (set by the Worker's build in server/wrangler.jsonc)
// Connect wallet (account-ui.ts): only when the site has a game server
const server = !!import.meta.env.PUBLIC_GAME_SERVER;
const build = (import.meta.env.PUBLIC_BUILD as string | undefined)?.slice(0, 7) ?? '';
// The touch controls' pixel icons as one sprite (docs/controls-plan.md): `<use href="#tc-<name>">` in each button
const tcSymbols = Object.entries(TC_ICONS).map(([id, rows]) => ({ id: `tc-${id}`, d: tcIconPath(rows) }));
---

<section class="city has-start" aria-labelledby="city-title" data-city-root data-view="loading" data-mode="explore" data-degen={degenBig.src} data-logo={logoBig.src} data-flame={flameImg.src}>
  {/* No 3D here (data-view="none": no WebGL 2, or the city couldn't start): the page says so.
      The ☰ Menu still has the comic page and the links. */}
  <div class="city-no3d" data-no3d hidden>
    <div class="city-no3d-card" role="status">
      <p class="kicker"><span class="kicker-num">3D</span> The Trenches</p>
      <p class="city-no3d-text">The Trenches needs a device with 3D graphics (WebGL&nbsp;2).</p>
      <p class="city-no3d-note">Try another browser or device.</p>
    </div>
  </div>

  {/* The 3D city: canvas is added by the script; pins float over their buildings */}
  <div class="city3d" data-city3d>
    <div class="city-pins">
      {directory.map((id) => (
        <button type="button" class="city-pin" data-pin={id} tabindex="-1" aria-hidden="true">
          <span class="city-pin-card">
            <span class="city-pin-title">{spots[id].title}</span>
            <span class="city-pin-sub">{spots[id].sub}</span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <div class="city-loader" data-loader hidden>
    <p class="kicker"><span class="kicker-num">3D</span> Entering Sector 7</p>
    <div class="city-loader-bar" data-loader-bar><span></span></div>
  </div>

  {/* The start menu (the owner's call): over everything on every open, while the 3D city loads behind it.
      Single player enters the city; Multiplayer joins other Degens when there's a game server (coming soon
      without one); Options holds time, weather and sound. Nothing of the city shows until you pick. */}
  {/* Maintenance (live settings, live.ts): over everything, the start menu too, while the owner has the city closed.
      The city doesn't boot behind it; when it lifts the page reloads. */}
  <div class="city-start city-maint" data-maint role="dialog" aria-modal="true" aria-labelledby="city-maint-title" hidden>
    <div class="city-start-card city-start-box">
      <Picture src={trenches} formats={['avif', 'webp']} fallbackFormat="webp" widths={[240, 480, 720]} sizes="240px" alt="" loading="eager" class="city-start-logo" />
      <p class="city-start-kicker">The Trenches</p>
      <p class="city-start-title" id="city-maint-title">Back <span class="hl">soon</span></p>
      <p class="city-maint-text" data-maint-text></p>
      <p class="city-maint-eta" data-maint-eta hidden></p>
      <p class="city-maint-note">Your save is safe. The city reopens by itself.</p>
    </div>
  </div>

  {/* The title screen (start.css, in the menus' arcade kit): the game's logo, the log-in screen, then the start
       menu. Logging in isn't built yet: the form sends nothing anywhere and says so; Play as guest goes on to the
       menu with the save in this browser, as before. */}
  <div class="city-start" data-start role="dialog" aria-modal="true" aria-label="The Trenches">
    <div class="city-start-card">
      <Picture src={trenches} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 480, 640, 960, 1280]} sizes="(max-width: 600px) 92vw, 560px" alt="The Trenches" loading="eager" fetchpriority="high" class="city-start-brand" />
      <div class="city-start-box">
      <form class="city-start-login" data-start-login novalidate>
        <p class="city-start-head">Log in</p>
        <label class="city-start-field">
          <span class="city-start-label">Player name or email</span>
          <input type="text" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" maxlength="64" />
        </label>
        <label class="city-start-field">
          <span class="city-start-label">Password</span>
          <input type="password" name="password" autocomplete="current-password" maxlength="128" />
        </label>
        <p class="city-start-msg" data-start-msg aria-live="polite" hidden></p>
        <button type="submit" class="mk-btn is-main city-start-go">Log in</button>
        <p class="city-start-or"><span>or</span></p>
        <button type="button" class="mk-btn city-start-go" data-start-guest>Play as guest</button>
        <p class="city-start-new">New here? <button type="button" class="city-start-link" data-start-signup>Create an account</button></p>
      </form>
      <div class="city-start-main" data-start-main hidden>
        <button type="button" class="city-start-btn" data-start-single>
          <span class="city-start-btn-name">Single player</span>
          <span class="city-start-btn-sub">Play solo</span>
        </button>
        <button type="button" class="city-start-btn" data-start-multi aria-disabled={server ? 'false' : 'true'}>
          <span class="city-start-btn-name">Multiplayer</span>
          <span class="city-start-btn-sub">{server ? 'Play with others' : 'Coming soon'}</span>
        </button>
        <button type="button" class="city-start-btn" data-start-options aria-expanded="false">
          <span class="city-start-btn-name">Options</span>
          <span class="city-start-btn-sub">Time, weather, sound</span>
        </button>
        <p class="city-start-who">Playing as guest · <button type="button" class="city-start-link" data-start-relog>Log in</button></p>
      </div>
      <div class="city-start-options" data-start-pane hidden>
        <div class="city-start-row">
          <span class="city-start-label">Time</span>
          <div class="city-start-seg" role="group" aria-label="Time of day">
            <button type="button" data-opt="time" data-val="live" aria-pressed="false">Live</button>
            <button type="button" data-opt="time" data-val="day" aria-pressed="true">Day</button>
            <button type="button" data-opt="time" data-val="sunset" aria-pressed="false">Sunset</button>
            <button type="button" data-opt="time" data-val="night" aria-pressed="false">Night</button>
          </div>
        </div>
        <div class="city-start-row">
          <span class="city-start-label">Weather</span>
          <div class="city-start-seg" role="group" aria-label="Weather">
            <button type="button" data-opt="weather" data-val="auto" aria-pressed="false">Auto</button>
            <button type="button" data-opt="weather" data-val="clear" aria-pressed="true">Clear</button>
            <button type="button" data-opt="weather" data-val="rain" aria-pressed="false">Rain</button>
          </div>
        </div>
        <div class="city-start-row">
          <span class="city-start-label">Sound</span>
          <div class="city-start-seg" role="group" aria-label="Sound">
            <button type="button" data-opt="sound" data-val="off" aria-pressed="true">Off</button>
            <button type="button" data-opt="sound" data-val="on" aria-pressed="false">On</button>
          </div>
        </div>
        {/* The credits the city's borrowed work asks for (docs/animation-plan.md): named, never linked */}
        <details class="city-start-credits">
          <summary><span class="city-start-label">Credits</span></summary>
          <p>Degen's movement is motion capture from the CMU Graphics Lab Motion Capture Database (mocap.cs.cmu.edu), created with funding from NSF EIA-0196217, in Bruce Hahne's BVH conversion.</p>
        </details>
        <button type="button" class="mk-btn is-small city-start-back" data-start-back>Back</button>
      </div>
      <p class="city-start-status" aria-live="polite"><span data-start-status>Loading the city…</span></p>
      <div class="city-start-bar" data-start-bar><span></span></div>
      </div>
      <p class="city-start-note">Draft · v0{build && ` · ${build}`} · Dorras are game money only.</p>
    </div>
  </div>

  {/* View settings, only while the 3D city is up */}

  {/* The mode header: which view you are in, the walk tabs while walking, and the City / Walk switch.
       Its title and subtitle are painted by head.ts. Clear over the game, no logo (docs/controls-plan.md
       Phase 5); in play only the hub's button and the gun's readout stay (controls.css). */}
  <header class="city-head mk-skin" data-city-head>
    <div class="city-head-id">
      <p class="city-head-text"><b data-head-title>The Trenches</b><small data-head-sub>Loading the city</small></p>
    </div>
    {/* Emotes and phrases (multiplayer.ts, online only; T opens it): the one walk tab left, the hub has the rest */}
    <div class="walk-top">
      <details class="walk-pop walk-emotes" data-pop data-emotes hidden>
        <summary aria-label="Emotes and phrases">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" /></svg>
          <span class="walk-pill-text">Emote</span>
        </summary>
        <div class="walk-settings-body">
          <div class="pop-head">
            <p class="pop-title">Emotes</p>
            <button type="button" class="pop-close" data-pop-close aria-label="Close emotes">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
            </button>
          </div>
          <div class="emote-grid" data-emote-grid></div>
          <div class="phrase-grid" data-phrase-grid></div>
          <p class="walk-pad">Shortcut: T</p>
        </div>
      </details>
    </div>
    {/* Walking with a gun: ammo and score (combat.ts paints them) */}
    <div class="city-head-stats" aria-live="off">
      <div class="combat-ammo"><b data-mag>30</b><span>/ <span data-reserve>120</span></span><small class="combat-gun" data-gun>Assault Rifle</small><small data-reload-hint hidden>R to reload</small></div>
      <div class="combat-score">Score <b data-score>0</b><small data-streak hidden></small></div>
    </div>
    {/* Online / Offline (online.ts): only when the site is built with a game server */}
    <div class="city-online" data-online-switch role="group" aria-label="Online or offline" hidden>
      <i class="mp-dot" data-online-dot data-state="off" aria-hidden="true"></i>
      <button type="button" data-online-set="on" aria-pressed="true">On<span class="city-online-long">line</span></button>
      <button type="button" data-online-set="off" aria-pressed="false">Off<span class="city-online-long">line</span></button>
    </div>
    <div class="city-head-modes" role="group" aria-label="View mode">
      <button type="button" class="city-mode-btn" data-mode-city aria-pressed="true" hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V9l5-3v15M10 21V4l9 4v13M14 10h2M14 14h2M7 12h1M7 16h1" /></svg>
        <span class="city-mode-label">City</span>
      </button>
      <button type="button" class="city-mode-btn" data-walk-toggle aria-pressed="false" hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="13" cy="4" r="2" /><path d="M9 20l2-6 3 3v4M7 12l3-4 4 1 2 4M11 14l-2-2" /></svg>
        <span class="city-mode-label" data-walk-label>Walk</span>
      </button>
    </div>
    {/* Settings and the menu (directory, PulseChain native, X, Telegram), and Connect wallet when there's a game server */}
    <div class="city-head-tools">
      {/* Your Dorras (tycoon-ui.ts): opens your stall's card; a dot when the till has takings */}
      <button type="button" class="dorras-pill" data-dorras data-hub-keep aria-label="Dorras: open your business">
        <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" opacity=".18" /><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" /><path d="M9 7h3.5a5 5 0 0 1 0 10H9zM7 12h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span class="dorras-amount" data-dorras-amount>0</span>
        <i class="dorras-dot" aria-hidden="true"></i>
      </button>
      {/* Your level (missions-ui.ts): "Lv 7" over its XP bar. Drops a card in the city; while walking it opens the Profile tab's badges. */}
      <button type="button" class="level-pill" data-level data-hub-tab="missions" aria-label="Level 1, Newcomer" title="Newcomer">
        <span class="level-tag" data-level-tag>Lv 1</span>
        <i class="level-bar" data-level-bar style="--v:0" aria-hidden="true"></i>
      </button>
      {server && (
        <button type="button" class="nav-account" data-account-nav aria-label="Connect your wallet" onclick="this.dataset.wanted='1'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H18v4" /><path d="M3 7.5v10A2.5 2.5 0 0 0 5.5 20H20V9H5.5A2.5 2.5 0 0 1 3 7.5z" /><circle cx="16" cy="14.5" r="1.2" /></svg>
          <span class="nav-account-label" data-account-label>Connect<span class="nav-account-more"> wallet</span></span>
        </button>
      )}
      {/* The hub (hub.ts): the menu for everything that isn't a place or a shop; Esc and Start open it too */}
      <button type="button" class="hub-btn" data-hub-open aria-controls="hub" aria-expanded="false" aria-label="Menu (Esc)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <span class="head-btn-text">Menu</span>
      </button>
    </div>
  </header>

  {/* The hub (hub.ts, docs/menu-plan.md Phase 2): the pause screen in the menus' arcade kit (menus.css), its
      tabs Map, Bag, Business, Missions, Profile, Settings (and Online with a game server). `data-hub-walk`
      shows only while walking, `data-hub-city` only in the City view. Without the 3D city only Map is there. */}
  <section class="mk mk-hub" id="hub" data-hub data-input="keys" hidden role="dialog" aria-labelledby="hub-title">
    <div class="mk-grab" data-mk-grab aria-hidden="true"><span></span></div>
    <header class="mk-bar">
      <div class="mk-heading">
        <p class="mk-kind"><span data-hub-walk>Paused</span><span data-hub-city>Menu</span></p>
        <h2 id="hub-title" class="mk-title">The Trenches</h2>
      </div>
      <button type="button" class="mk-x" data-hub-close aria-label="Close the menu"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg></button>
    </header>
    <nav class="mk-tabs hub-tabs" data-mk-tabs role="tablist" aria-label="Menu">
      <button type="button" role="tab" data-tab="map" aria-selected="true">Map</button>
      <button type="button" role="tab" data-tab="bag" aria-selected="false" class="hub-3d">Bag</button>
      <button type="button" role="tab" data-tab="business" aria-selected="false" class="hub-3d">Business</button>
      <button type="button" role="tab" data-tab="missions" aria-selected="false" class="hub-3d">Missions</button>
      <button type="button" role="tab" data-tab="profile" aria-selected="false" class="hub-3d">Profile</button>
      <button type="button" role="tab" data-tab="settings" aria-selected="false" class="hub-3d">Settings</button>
      <button type="button" role="tab" data-tab="online" aria-selected="false" class="hub-3d" data-mp hidden><i class="mp-dot" data-mp-dot data-state="off" aria-hidden="true"></i>Online</button>
    </nav>
    <div class="mk-body" data-mk-swipe>
      <div class="mk-page hub-page" data-page="map" role="tabpanel" aria-label="Map">
        <button type="button" class="mk-btn is-main hub-wide hub-3d" data-worldmap-open>World map<span class="hub-key" aria-hidden="true">M</span></button>
        <p class="mk-label hub-label hub-3d">Places</p>
        <ul class="hub-places dir-places hub-3d">
            {directory.map((id) => {
              const s = spots[id];
              return (
                <li>
                  <a href="#city-title" data-dir-spot={id}>
                    <span>{s.title}</span>
                    <small>{s.sub}</small>
                  </a>
                </li>
              );
            })}
          </ul>
        <p class="mk-label hub-label">More</p>
          <ul class="hub-links dir-links">
            <li>
              <a href="/emporium">
                <span>The Emporium comic</span>
                <small>The six windows</small>
              </a>
            </li>
            {SHOP_OPEN && (
              <li>
                <a href={SHOP_URL} {...ext}>
                  <span>Merch store</span>
                  <small>Drop 001</small>
                </a>
              </li>
            )}
          </ul>
          <div class="hub-social">
            <span class="chain-badge">
              <Image src={pulsechain} alt="" width={18} densities={[1, 2, 3]} class="chain-badge-mark" />
              <span>PulseChain native</span>
            </span>
            <a href={X_URL} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label={`@${X_HANDLE} on X`}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="Telegram">
