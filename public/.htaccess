# Degen Emporium on Hostinger (Apache / LiteSpeed)

# Show the site's own not-found page
ErrorDocument 404 /404.html

# File types the site uses that older servers may not know
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js .mjs
  AddType image/ktx2 .ktx2
  AddType application/wasm .wasm
  AddType application/octet-stream .bin
</IfModule>

# Security headers (docs/security-plan.md Phase 1). The same set is in _headers for the workers.dev copy;
# tests/headers.test.ts holds the two to the same values. The full policy is report-only until Phase 5.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.reown.com; font-src 'self' data: https://fonts.gstatic.com https://fonts.reown.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' data: blob: https://jqdoyzpblaavkvenvria.supabase.co https://emporium.144collective.workers.dev wss://emporium.144collective.workers.dev wss://relay.walletconnect.org wss://relay.walletconnect.com https://*.walletconnect.org https://*.walletconnect.com https://api.web3modal.org https://rpc.pulsechain.com https://rpc.v4.testnet.pulsechain.com; frame-src https://verify.walletconnect.org https://verify.walletconnect.com https://secure.walletconnect.org https://secure-mobile.walletconnect.org; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; report-uri https://emporium.144collective.workers.dev/csp-report; report-to csp"
  Header always set Reporting-Endpoints "csp=\"https://emporium.144collective.workers.dev/csp-report\""
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  # (application/octet-stream: the motion capture's clips, src/data/mocap, which compress by a fifth)
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml application/wasm application/octet-stream
</IfModule>

# Files in /_astro/ have a fingerprint in their name (the textures their hash, the transcoder three's
# version in its folder's), so they can be cached for a year.
# Pages are re-checked on every visit, so a new upload shows up straight away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|avif|webp|png|jpg|ico|woff2|ktx2|wasm|bin)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # The service worker (its name has no fingerprint): always re-checked, so an update reaches everyone
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
